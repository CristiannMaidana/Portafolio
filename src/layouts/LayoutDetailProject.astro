---
import LanguagePreferenceScript from '../components/LanguagePreferenceScript.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ThemeHeadScript from '../components/ThemeHeadScript.astro';
import ThemePreferenceScript from '../components/ThemePreferenceScript.astro';
import ThemeToggleButton from '../components/ThemeToggleButton.astro';
import { getLocale, localizePath } from '../i18n/config';
import { ui } from '../i18n/ui';

const { title = 'EcoUshuaia', theme = 'eco' } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
const backHref = localizePath(locale, '/#projects');
---

<!DOCTYPE html>
<html lang={t.meta.lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <ThemeHeadScript />
    <style is:inline>
        :root {
            --detail-page-bg-start: #f8faf7;
            --detail-page-bg-end: #f5f7f4;
            --detail-page-glow: rgba(184, 223, 179, 0.34);
            --detail-page-text: #111111;
            --detail-header-text: #f4f8f3;
            --detail-header-border: rgba(255, 255, 255, 0.12);
            --detail-header-shadow: 0 18px 35px rgba(0, 0, 0, 0.22);
            --detail-header-eco-start: #060807;
            --detail-header-eco-mid: #101713;
            --detail-header-eco-end: #1a251d;
            --detail-header-food-start: #1b0507;
            --detail-header-food-mid: #3a0d10;
            --detail-header-food-end: #6d181f;
            --detail-control-border: rgba(255, 255, 255, 0.14);
            --detail-control-bg: rgba(255, 255, 255, 0.08);
            --detail-control-hover: rgba(151, 235, 166, 0.12);
            --detail-control-hover-border: rgba(151, 235, 166, 0.32);
            --detail-control-hover-food: rgba(255, 126, 126, 0.14);
            --detail-control-hover-food-border: rgba(255, 126, 126, 0.36);
            --detail-control-icon-bg: rgba(255, 255, 255, 0.12);
            --detail-surface-theme: rgba(255, 255, 255, 0.76);
            --detail-text-theme: #1d1d1f;
            --detail-muted-theme: #667064;
            --detail-accent-theme: #3f7f4f;
            --detail-border-theme: rgba(83, 125, 89, 0.16);
            --detail-shadow-theme: 0 24px 70px rgba(42, 78, 48, 0.08);
            --detail-chip-bg-theme: rgba(255, 255, 255, 0.66);
            --detail-lead-theme: #475146;
            --detail-card-shadow-theme: 0 18px 48px rgba(43, 74, 46, 0.055);
            --detail-card-hover-bg-theme: rgba(255, 255, 255, 0.88);
            --detail-card-hover-border-theme: rgba(83, 125, 89, 0.28);
            --detail-final-panel-bg-theme: linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(241, 248, 239, 0.72));
            --detail-image-bg-theme: linear-gradient(135deg, rgba(238, 250, 235, 0.94), rgba(217, 241, 215, 0.9)), radial-gradient(circle at 30% 30%, rgba(150, 222, 147, 0.8), transparent 24rem);
            --detail-video-border-theme: rgba(0, 0, 0, 0.88);
        }

        :root[data-theme='dark'] {
            --detail-page-bg-start: #07100b;
            --detail-page-bg-end: #0d1611;
            --detail-page-glow: rgba(108, 188, 128, 0.16);

            --detail-page-text: #eef6f0;
            --detail-header-text: #f4faf5;
            --detail-header-border: rgba(210, 235, 216, 0.10);
            --detail-header-shadow: 0 18px 38px rgba(0, 0, 0, 0.48);

            --detail-header-eco-start: #030604;
            --detail-header-eco-mid: #07100b;
            --detail-header-eco-end: #101d15;

            --detail-header-food-start: #130406;
            --detail-header-food-mid: #26090d;
            --detail-header-food-end: #491219;

            --detail-control-border: rgba(210, 235, 216, 0.14);
            --detail-control-bg: rgba(255, 255, 255, 0.055);
            --detail-control-hover: rgba(128, 214, 148, 0.13);
            --detail-control-hover-border: rgba(128, 214, 148, 0.30);

            --detail-control-hover-food: rgba(255, 132, 132, 0.16);
            --detail-control-hover-food-border: rgba(255, 132, 132, 0.30);
            --detail-control-icon-bg: rgba(255, 255, 255, 0.08);

            --detail-surface-theme: rgba(16, 26, 20, 0.82);
            --detail-text-theme: #f1f7f2;
            --detail-muted-theme: #a8b8ad;
            --detail-accent-theme: #8fd8a0;
            --detail-border-theme: rgba(143, 216, 160, 0.18);

            --detail-shadow-theme: 0 24px 70px rgba(0, 0, 0, 0.34);
            --detail-chip-bg-theme: rgba(20, 34, 26, 0.76);
            --detail-lead-theme: #c0cec4;

            --detail-card-shadow-theme: 0 18px 48px rgba(0, 0, 0, 0.24);
            --detail-card-hover-bg-theme: rgba(22, 36, 28, 0.94);
            --detail-card-hover-border-theme: rgba(143, 216, 160, 0.30);

            --detail-final-panel-bg-theme:
                linear-gradient(
                    135deg,
                    rgba(20, 34, 26, 0.94),
                    rgba(10, 18, 14, 0.92)
                );

            --detail-image-bg-theme:
                linear-gradient(
                    135deg,
                    rgba(19, 44, 29, 0.96),
                    rgba(10, 25, 17, 0.94)
                ),
                radial-gradient(
                    circle at 30% 30%,
                    rgba(92, 176, 112, 0.38),
                    transparent 24rem
                );

            --detail-video-border-theme: rgba(255, 255, 255, 0.12);
        }
    </style>
</head>
<body>
    <header class={`detail-layout-header ${theme === 'food' ? 'food-theme' : 'eco-theme'}`}>
        <button class="detail-layout-back-button" type="button" onclick={`window.location.replace('${backHref}')`} aria-label={t.detailLayout.backAria}>
            <span class="detail-layout-back-icon" aria-hidden="true">←</span>
            <span>{t.detailLayout.back}</span>
        </button>
        <div class="detail-layout-title-group">
            <h1 class="detail-layout-title">{title}</h1>
            <div class="detail-layout-actions">
                <ThemeToggleButton />
                <LanguageSwitcher path={Astro.url.pathname} className="detail-layout-language-switcher" />
            </div>
        </div>
    </header>

    <main class="detail-layout-content">
        <slot />
    </main>

    <LanguagePreferenceScript />
    <ThemePreferenceScript />
</body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        min-height: 100%;
    }

    body {
        background:
            radial-gradient(circle at top left, var(--detail-page-glow), transparent 34rem),
            linear-gradient(180deg, var(--detail-page-bg-start) 0%, var(--detail-page-bg-end) 100%);
        color: var(--detail-page-text);
    }

    .detail-layout-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        width: 100%;
        padding: 18px clamp(20px, 4vw, 48px);
        box-sizing: border-box;
        background: linear-gradient(135deg, var(--detail-header-eco-start) 0%, var(--detail-header-eco-mid) 55%, var(--detail-header-eco-end) 100%);
        border-bottom: 1px solid var(--detail-header-border);
        box-shadow: var(--detail-header-shadow);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
    }

    .detail-layout-header.eco-theme {
        background: linear-gradient(135deg, var(--detail-header-eco-start) 0%, var(--detail-header-eco-mid) 55%, var(--detail-header-eco-end) 100%);
    }

    .detail-layout-header.food-theme {
        background: linear-gradient(135deg, var(--detail-header-food-start) 0%, var(--detail-header-food-mid) 48%, var(--detail-header-food-end) 100%);
    }

    .detail-layout-back-button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        border: 1px solid var(--detail-control-border);
        border-radius: 999px;
        background: var(--detail-control-bg);
        color: var(--detail-header-text);
        padding: 12px 18px;
        cursor: pointer;
        font: inherit;
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        transition: background-color .25s ease, transform .25s ease, border-color .25s ease;
    }

    .detail-layout-back-button:hover {
        background: var(--detail-control-hover);
        border-color: var(--detail-control-hover-border);
        transform: translateY(-1px);
    }

    .detail-layout-header.food-theme .detail-layout-back-button:hover {
        background: var(--detail-control-hover-food);
        border-color: var(--detail-control-hover-food-border);
    }

    .detail-layout-back-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--detail-control-icon-bg);
        font-size: 1.1rem;
        line-height: 1;
    }

    .detail-layout-title {
        margin: 0;
        color: var(--detail-header-text);
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(1.4rem, 2.6vw, 2.2rem);
        letter-spacing: 0.02em;
    }

    .detail-layout-title-group {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-left: auto;
    }

    .detail-layout-actions {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    :global(.detail-layout-language-switcher) {
        color: var(--detail-header-text);
    }

    .detail-layout-content {
        margin: 0;
        padding: 0 0 100px;
    }

    @media (max-width: 1100px) {
        .detail-layout-header {
            flex-wrap: wrap;
            align-items: flex-start;
        }

        .detail-layout-title-group {
            width: 100%;
            justify-content: space-between;
        }

        .detail-layout-title {
            width: 100%;
        }
    }

    @media (max-width: 900px) {
        .detail-layout-content {
            margin: 0 32px;
            padding: 0 0 120px;
        }
    }

    @media (max-width: 640px) {
        .detail-layout-title-group {
            align-items: flex-start;
            gap: 12px;
        }

        .detail-layout-content {
            margin: 0 16px;
            padding: 0 0 96px;
        }
    }
</style>
