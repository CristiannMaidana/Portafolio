---
const { title = 'EcoUshuaia' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
</head>
<body>
    <header class="detail-layout-header">
        <button class="detail-layout-back-button" type="button" onclick="history.back()" aria-label="Go back">
            <span class="detail-layout-back-icon" aria-hidden="true">←</span>
            <span>Volver</span>
        </button>
        <h1 class="detail-layout-title">{title}</h1>
    </header>

    <main class="detail-layout-content">
        <slot />
    </main>
</body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        min-height: 100%;
    }

    body {
        background: #ffffff;
        color: #111111;
    }

    .detail-layout-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        width: 100%;
        padding: 18px clamp(20px, 4vw, 48px);
        box-sizing: border-box;
        background: linear-gradient(135deg, #060807 0%, #101713 55%, #1a251d 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 18px 35px rgba(0, 0, 0, 0.22);
    }

    .detail-layout-back-button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        color: #f4f8f3;
        padding: 12px 18px;
        cursor: pointer;
        font: inherit;
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        transition: background-color .25s ease, transform .25s ease, border-color .25s ease;
    }

    .detail-layout-back-button:hover {
        background: rgba(151, 235, 166, 0.12);
        border-color: rgba(151, 235, 166, 0.32);
        transform: translateY(-1px);
    }

    .detail-layout-back-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        font-size: 1.1rem;
        line-height: 1;
    }

    .detail-layout-title {
        margin: 0;
        color: #f4f8f3;
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(1.4rem, 2.6vw, 2.2rem);
        letter-spacing: 0.02em;
    }

    .detail-layout-content {
        margin: 0 200px 200px;
    }

    @media (max-width: 1100px) {
        .detail-layout-header {
            flex-wrap: wrap;
            align-items: flex-start;
        }

        .detail-layout-title {
            width: 100%;
        }
    }

    @media (max-width: 900px) {
        .detail-layout-content {
            margin: 0 32px 120px;
        }
    }

    @media (max-width: 640px) {
        .detail-layout-content {
            margin: 0 16px 96px;
        }
    }
</style>
