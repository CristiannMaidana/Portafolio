---
import LanguagePreferenceScript from '../components/LanguagePreferenceScript.astro';
import ThemeHeadScript from '../components/ThemeHeadScript.astro';
import ThemePreferenceScript from '../components/ThemePreferenceScript.astro';
import { getLocale } from '../i18n/config';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
---

<!doctype html>
<html lang={t.meta.lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{t.meta.portfolioTitle}</title>
    <ThemeHeadScript />
    <style is:inline>
        :root {
            --surface: rgba(255, 255, 255, 0.72);
            --surface-2: rgba(255, 255, 255, 0.48);
            --surface-58: rgba(255, 255, 255, 0.58);
            --surface-62: rgba(255, 255, 255, 0.62);
            --surface-66: rgba(255, 255, 255, 0.66);
            --surface-70: rgba(255, 255, 255, 0.7);
            --portfolio-text: #14191c;
            --portfolio-muted: #333333;
            --portfolio-heading: #000000;
            --portfolio-border: rgba(255, 255, 255, 0.78);
            --portfolio-input-border: #d0d7de;
            --portfolio-divider: #808080;
            --portfolio-accent: #85e7fb;
            --portfolio-accent-alt: #85dffb;
            --portfolio-accent-start: #66e3ff;
            --portfolio-accent-end: #7c5cff;
            --portfolio-button-text: #0b0d10;
            --portfolio-button-hover: #f6f8fa;
            --portfolio-surface: var(--surface);
            --portfolio-nav-bg: rgba(20, 25, 28, 0.75);
            --portfolio-nav-link: #9198a2;
            --portfolio-nav-link-hover: #ffffff;
            --portfolio-terminal-bg: rgba(255, 255, 255, 0.58);
            --portfolio-terminal-border: rgba(255, 255, 255, 0.78);
            --portfolio-terminal-shadow: rgba(0, 0, 0, 0.1);
            --portfolio-terminal-panel: rgba(29, 29, 31, 0.94);
            --portfolio-code-text: #f5f5f7;
            --portfolio-code-keyword: #5ac8fa;
            --portfolio-code-value: #7ee787;
            --portfolio-code-stack: #8b949e;
            --portfolio-window-red: #ff5f57;
            --portfolio-window-yellow: #ffbd2e;
            --portfolio-window-green: #28c840;
            --portfolio-stat-surface: rgba(255, 255, 255, 0.62);
            --portfolio-showcase-border: rgba(255, 255, 255, 0.78);
            --portfolio-showcase-bg: linear-gradient(165deg, #d8ffb8 0%, #9af08d 42%, #67d978 100%);
            --portfolio-showcase-highlight: rgba(255, 255, 255, 0.55);
            --portfolio-showcase-shadow-top: rgba(53, 144, 68, 0.22);
            --portfolio-showcase-shadow-bottom: rgba(63, 152, 77, 0.28);
            --portfolio-error: #ff6b6b;
            --portfolio-success: #5ec26a;
            --portfolio-page-bg: #f5f5f7;
            --ambient-bg-start: #fbfbfd;
            --ambient-bg-mid: #f5f5f7;
            --ambient-bg-end: #ffffff;
            --ambient-radial-one: rgba(0, 113, 227, 0.16);
            --ambient-radial-two: rgba(90, 200, 250, 0.18);
            --ambient-radial-three: rgba(52, 199, 89, 0.12);
            --grid-line: rgba(29, 29, 31, 0.045);
            --mesh-one: rgba(0, 113, 227, 0.3);
            --mesh-two: rgba(90, 200, 250, 0.28);
            --mesh-three: rgba(52, 199, 89, 0.16);
            --mesh-blend: multiply;
        }

        :root[data-theme='dark'] {
            --surface: rgba(18, 23, 31, 0.82);
            --surface-2: rgba(20, 26, 34, 0.52);
            --surface-58: rgba(20, 26, 34, 0.58);
            --surface-62: rgba(20, 26, 34, 0.62);
            --surface-66: rgba(20, 26, 34, 0.66);
            --surface-70: rgba(13, 17, 24, 0.78);

            --portfolio-text: #edf2f7;
            --portfolio-muted: #aab4c2;
            --portfolio-heading: #f8fbff;
            --portfolio-border: rgba(133, 157, 184, 0.18);
            --portfolio-input-border: rgba(133, 157, 184, 0.26);
            --portfolio-divider: rgba(255, 255, 255, 0.12);

            --portfolio-accent: #8bdff3;
            --portfolio-accent-alt: #91e7f8;
            --portfolio-accent-start: #6fe3ff;
            --portfolio-accent-end: #5eb7ff;

            --portfolio-button-text: #041017;
            --portfolio-button-hover: rgba(255, 255, 255, 0.06);
            --portfolio-surface: rgba(11, 15, 21, 0.9);

            --portfolio-nav-bg: rgba(9, 12, 18, 0.76);
            --portfolio-nav-link: #c0cad6;
            --portfolio-nav-link-hover: #ffffff;

            --portfolio-terminal-bg: rgba(13, 18, 24, 0.78);
            --portfolio-terminal-border: rgba(133, 157, 184, 0.16);
            --portfolio-terminal-shadow: rgba(0, 0, 0, 0.34);
            --portfolio-terminal-panel: rgba(5, 8, 12, 0.96);

            --portfolio-code-text: #eef6ff;
            --portfolio-code-keyword: #70d6ff;
            --portfolio-code-value: #7ee7a6;
            --portfolio-code-stack: #8ca0b8;

            --portfolio-window-red: #ff5f57;
            --portfolio-window-yellow: #ffbd2e;
            --portfolio-window-green: #28c840;

            --portfolio-stat-surface: rgba(17, 22, 30, 0.82);

            --portfolio-showcase-border: rgba(133, 157, 184, 0.18);
            --portfolio-showcase-bg: linear-gradient(165deg, #183426 0%, #1f5f3b 42%, #2e8f56 100%);
            --portfolio-showcase-highlight: rgba(255, 255, 255, 0.08);
            --portfolio-showcase-shadow-top: rgba(13, 24, 20, 0.38);
            --portfolio-showcase-shadow-bottom: rgba(4, 7, 11, 0.38);

            --portfolio-error: #ff7a7a;
            --portfolio-success: #74d88a;

            --portfolio-page-bg: #0a0f16;

            --ambient-bg-start: #071018;
            --ambient-bg-mid: #0a1119;
            --ambient-bg-end: #101824;

            --ambient-radial-one: rgba(35, 120, 255, 0.16);
            --ambient-radial-two: rgba(42, 196, 255, 0.14);
            --ambient-radial-three: rgba(59, 208, 124, 0.12);

            --grid-line: rgba(255, 255, 255, 0.04);

            --mesh-one: rgba(21, 101, 216, 0.28);
            --mesh-two: rgba(25, 177, 255, 0.24);
            --mesh-three: rgba(38, 173, 105, 0.16);
            --mesh-blend: screen;
        }

        html {
            background: var(--portfolio-page-bg);
        }

        body.portfolio-body {
            background: var(--portfolio-page-bg);
            color: var(--portfolio-text);
        }

        .btn.primary,
        .bt.primary,
        .contact-form button {
            background: linear-gradient(135deg, var(--portfolio-accent-start), var(--portfolio-accent-end));
            color: var(--portfolio-button-text);
        }

        .btn.secondary,
        .bt.secundary {
            background: var(--portfolio-surface);
            border-color: var(--portfolio-input-border);
            color: var(--portfolio-text);
        }

        .card,
        .data,
        .tecnology,
        .contact-page,
        .container-data,
        .container-terminal,
        .app-showcase {
            border-color: var(--portfolio-border);
            background: var(--surface);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        .inputs input,
        .msg textarea {
            border-color: var(--portfolio-input-border);
            background: var(--surface-70);
            color: var(--portfolio-text);
        }

        .container-terminal {
            background: var(--portfolio-terminal-bg);
        }

        .app-showcase {
            border-color: var(--portfolio-showcase-border);
            background: var(--portfolio-showcase-bg);
        }

        .project-kicker,
        h3,
        text {
            color: var(--portfolio-accent);
        }

        p {
            color: var(--portfolio-muted);
        }

        h1,
        h2 {
            color: var(--portfolio-heading);
        }
    </style>
</head>
<body class="portfolio-body">
    <div class="ambient" aria-hidden="true">
        <div class="soft-grid"></div>
        <div class="mesh one"></div>
        <div class="mesh two"></div>
        <div class="mesh three"></div>
    </div>

    <main class="portfolio-content">
        <slot />
    </main>

    <LanguagePreferenceScript />
    <ThemePreferenceScript />

    <script is:inline>
        const revealGroups = [];
        const nav = document.querySelector('nav');

        if (nav) {
            revealGroups.push([nav, ...nav.querySelectorAll('li')]);
        }

        const sectionTargets = [
            'h1',
            'h2',
            'h3',
            'p',
            'text',
            '.home-description',
            '.home-actions',
            '.container-terminal',
            '.card',
            '.app-showcase',
            '.content > *',
            '.tech-item',
            '.inputs input',
            '.msg textarea',
            '.contact-form button',
        ].join(', ');

        document.querySelectorAll('.portfolio-screen').forEach((section) => {
            revealGroups.push(Array.from(section.querySelectorAll(sectionTargets)));
        });

        revealGroups.forEach((group) => {
            group.forEach((element, index) => {
                element.dataset.reveal = '';
                element.style.setProperty('--reveal-order', String(index));
            });
        });

        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            if (nav) {
                requestAnimationFrame(() => {
                    nav.classList.add('is-visible');
                    nav.querySelectorAll('[data-reveal]').forEach((item) => item.classList.add('is-visible'));
                });
            }

            const revealImmediately = (element) => {
                const rect = element.getBoundingClientRect();
                return rect.top < window.innerHeight * 0.88 && rect.bottom > window.innerHeight * 0.08;
            };

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;

                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    });
                },
                {
                    threshold: 0.18,
                    rootMargin: '0px 0px -10% 0px',
                }
            );

            revealGroups.flat().forEach((element) => {
                if (element === nav || nav?.contains(element)) return;

                if (revealImmediately(element)) {
                    element.classList.add('is-visible');
                    return;
                }

                observer.observe(element);
            });
        } else {
            document.querySelectorAll('[data-reveal]').forEach((element) => element.classList.add('is-visible'));
        }
    </script>
</body>
</html>

<style>
	:global(:root) {
        --bg: var(--portfolio-page-bg);
    }

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

    :global(body) {
        background: var(--bg);
    }

    .portfolio-body {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        isolation: isolate;
    }

    .portfolio-content {
        position: relative;
        z-index: 1;
        width: 100%;
    }

    .ambient {
        position: fixed;
        inset: 0;
        z-index: -5;
        overflow: hidden;
        pointer-events: none;
        background:
            radial-gradient(circle at 16% 20%, var(--ambient-radial-one), transparent 30%),
            radial-gradient(circle at 80% 18%, var(--ambient-radial-two), transparent 28%),
            radial-gradient(circle at 78% 82%, var(--ambient-radial-three), transparent 30%),
            linear-gradient(180deg, var(--ambient-bg-start) 0%, var(--ambient-bg-mid) 45%, var(--ambient-bg-end) 100%);
    }

    .mesh {
        position: absolute;
        width: 52vw;
        aspect-ratio: 1;
        border-radius: 50%;
        filter: blur(50px);
        opacity: 0.48;
        mix-blend-mode: var(--mesh-blend);
        animation: meshFloat 18s ease-in-out infinite alternate;
    }

    .mesh.one {
        left: -14vw;
        top: 4vh;
        background: var(--mesh-one);
    }

    .mesh.two {
        right: -18vw;
        top: 28vh;
        background: var(--mesh-two);
        animation-delay: -5s;
    }

    .mesh.three {
        left: 28vw;
        bottom: -28vh;
        background: var(--mesh-three);
        animation-delay: -9s;
    }

    .soft-grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(var(--grid-line) 1px, transparent 1px),
            linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
        background-size: 70px 70px;
        mask-image: linear-gradient(to bottom, transparent, black 20%, black 70%, transparent);
        opacity: 0.55;
    }

    :global(.portfolio-screen) {
        min-height: 100svh;
        display: flex;
        align-items: center;
        padding: 120px 200px 72px;
        box-sizing: border-box;
    }

    :global(.portfolio-screen > *) {
        width: 100%;
    }

    :global([data-reveal]) {
        opacity: 0;
        transform: translate3d(0, 28px, 0) scale(0.985);
        will-change: opacity, transform;
        transition:
            opacity 0.68s cubic-bezier(0.22, 1, 0.36, 1),
            transform 0.68s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: calc(var(--reveal-order, 0) * 85ms);
    }

    :global(nav[data-reveal]) {
        transform: translate(-50%, -18px);
    }

    :global(p[data-reveal]) {
        transition-delay: calc((var(--reveal-order, 0) * 45ms) + 40ms);
    }

    :global(img[data-reveal]),
    :global(.container-terminal[data-reveal]),
    :global(.app-showcase[data-reveal]),
    :global(.tech-item[data-reveal]) {
        transition-delay: calc(var(--reveal-order, 0) * 30ms);
    }

    :global([data-reveal].is-visible) {
        opacity: 1;
        transform: translate3d(0, 0, 0) scale(1);
    }

    :global(nav[data-reveal].is-visible) {
        transform: translate(-50%, 0);
    }

    @media (max-width: 1600px) {
        :global(.portfolio-screen) {
            padding: 120px 160px 72px;
        }
    }

    @media (max-width: 1360px) {
        :global(.portfolio-screen) {
            padding: 112px 120px 64px;
        }
    }

    @media (max-width: 1200px) {
        :global(.portfolio-screen) {
            padding: 108px 88px 60px;
        }
    }

    @media (max-width: 768px) {
        :global(.portfolio-screen) {
            min-height: auto;
            padding: 108px 24px 56px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global([data-reveal]) {
            opacity: 1;
            transform: none;
            transition: none;
        }

        .mesh {
            animation: none;
        }
    }

    @keyframes meshFloat {
        from {
            transform: translate3d(0, 0, 0) scale(1);
        }

        to {
            transform: translate3d(40px, -60px, 0) scale(1.1);
        }
    }
</style>
