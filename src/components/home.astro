<style>
    .btn{
        padding: 16px 22px;
        border-radius: 16px;
        border: 1px solid transparent;
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: background-color .3s, color .3s, border-color .3s, transform .3s;
    }
    .btn.primary{
        background: linear-gradient(135deg, #66e3ff, #7c5cff);
        color: #0b0d10;
    }

    .btn.secondary{
        border-color: #d0d7de;
        color: #14191c;
        background: #ffffff;
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    .btn.primary:hover {
        background: linear-gradient(135deg, #ffd88d, #ffb274);
    }

    .btn.secondary:hover {
        background: #f6f8fa;
    }

    text {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 24px;
        color: #555;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    h1 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 90px;
        margin-top: 10px;
        margin-bottom: 20px;
    }

    p {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 24px;
        line-height: 1.6;
        color: #333;
    }
</style>
