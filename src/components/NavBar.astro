---
import { getLocale, localizePath } from '../i18n/config';
import { ui } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggleButton from './ThemeToggleButton.astro';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale];
---

<nav>
    <ul>
        <li><a href={localizePath(locale, '/#home')}>{t.nav.home}</a></li>
        <li><a href={localizePath(locale, '/#projects')}>{t.nav.projects}</a></li>
        <li><a href={localizePath(locale, '/#about')}>{t.nav.about}</a></li>
        <li><a href={localizePath(locale, '/#contact')}>{t.nav.contact}</a></li>
        <li><a href="/Curriculum%20-%20CRISTIAN%20MAIDANA.pdf" download>{t.nav.resume}</a></li>
        <li class="nav-controls-item">
            <div class="nav-controls">
                <ThemeToggleButton />
                <LanguageSwitcher path="/" />
            </div>
        </li>
    </ul>
</nav>

<style>
    nav {
        background-color: var(--portfolio-nav-bg);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        padding: 5px 18px;
        border-radius: 52px;
        width: min(720px, calc(100% - 32px));
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        box-sizing: border-box;
        z-index: 10;
    }
    ul {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        width: 100%;
        gap: 6px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li {
        padding: 10px 8px;
        color: var(--portfolio-nav-link);
        font-family: Arial, Helvetica, sans-serif;
        text-align: center;
    }

    li:hover {
        color: var(--portfolio-nav-link-hover);
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    .nav-controls-item {
        margin-left: auto;
        padding-right: 0;
    }

    .nav-controls {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    @media (max-width: 1100px) {
        nav {
            width: min(640px, calc(100% - 24px));
            padding: 8px;
        }

        li {
            padding: 8px 6px;
        }
    }

    @media (max-width: 768px) {
        nav {
            top: 12px;
            border-radius: 24px;
            padding: 8px 10px;
            overflow-x: auto;
        }

        ul {
            width: max-content;
            gap: 2px;
        }

        li {
            padding: 8px 4px;
            font-size: 13px;
        }

        .nav-controls-item {
            position: sticky;
            right: 0;
            padding-left: 8px;
            background: linear-gradient(90deg, rgba(15, 15, 15, 0) 0%, var(--portfolio-nav-bg) 32%);
        }

        .nav-controls {
            gap: 6px;
        }
    }
</style>
