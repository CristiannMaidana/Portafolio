---
import { getLocale } from '../i18n/config';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
---

<button
    class="theme-toggle-button"
    type="button"
    aria-label={ui[locale].theme.label}
    title={ui[locale].theme.label}
    aria-pressed="false"
    data-theme-toggle
>
    <span class="theme-toggle-thumb" aria-hidden="true"></span>
    <svg class="theme-toggle-icon sun-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="3.5" />
        <path d="M12 1.75v2.5" />
        <path d="M12 19.75v2.5" />
        <path d="M4.93 4.93l1.77 1.77" />
        <path d="M17.3 17.3l1.77 1.77" />
        <path d="M1.75 12h2.5" />
        <path d="M19.75 12h2.5" />
        <path d="M4.93 19.07l1.77-1.77" />
        <path d="M17.3 6.7l1.77-1.77" />
    </svg>
    <svg class="theme-toggle-icon moon-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.15 14.39A8 8 0 0 1 9.61 3.85a8 8 0 1 0 10.54 10.54Z" />
    </svg>
</button>

<style>
    .theme-toggle-button {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 0;
        width: 76px;
        height: 42px;
        padding: 0 10px;
        border: 1px solid var(--theme-toggle-border, rgba(255, 255, 255, 0.15));
        border-radius: 999px;
        background: var(--theme-toggle-bg, rgba(255, 255, 255, 0.12));
        color: inherit;
        cursor: pointer;
        overflow: hidden;
        transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
    }

    .theme-toggle-button:hover {
        background: var(--theme-toggle-hover-bg, rgba(255, 255, 255, 0.14));
        transform: translateY(-1px);
    }

    .theme-toggle-thumb {
        position: absolute;
        top: 4px;
        left: 4px;
        width: 30px;
        height: 32px;
        border-radius: 999px;
        background: var(--theme-toggle-thumb-bg, rgba(255, 255, 255, 0.16));
        box-shadow: var(
            --theme-toggle-thumb-shadow,
            inset 0 1px 0 rgba(255, 255, 255, 0.14),
            0 6px 16px rgba(0, 0, 0, 0.18)
        );
        transition: transform 0.22s ease, background-color 0.22s ease, box-shadow 0.22s ease;
    }

    .theme-toggle-icon {
        position: relative;
        z-index: 1;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: opacity 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

    .sun-icon {
        width: 16px;
        height: 16px;
        stroke-width: 1.8;
    }

    .moon-icon {
        width: 14px;
        height: 14px;
        stroke-width: 1.9;
        opacity: 0.82;
    }

    :global(:root[data-theme='dark']) .theme-toggle-button {
        background: var(--theme-toggle-bg-dark, rgba(255, 255, 255, 0.09));
        border-color: var(--theme-toggle-border-dark, rgba(255, 255, 255, 0.12));
    }

    :global(:root[data-theme='dark']) .theme-toggle-button .theme-toggle-thumb {
        transform: translateX(35px);
        background: var(--theme-toggle-thumb-bg-dark, rgba(170, 194, 255, 0.15));
        box-shadow: var(
            --theme-toggle-thumb-shadow-dark,
            inset 0 1px 0 rgba(255, 255, 255, 0.12),
            0 6px 18px rgba(0, 0, 0, 0.24)
        );
    }

    :global(:root[data-theme='dark']) .theme-toggle-button .sun-icon {
        opacity: 0.45;
        transform: scale(0.94);
    }

    :global(:root[data-theme='dark']) .theme-toggle-button .moon-icon {
        opacity: 1;
        transform: scale(1);
    }

    :global(:root[data-theme='light']) .theme-toggle-button .sun-icon {
        opacity: 1;
        transform: scale(1);
    }

    :global(:root[data-theme='light']) .theme-toggle-button .moon-icon {
        opacity: 0.5;
        transform: scale(0.94);
    }

    :global(:root[data-theme='light']) .theme-toggle-button .theme-toggle-thumb {
        transform: translateX(0);
    }

    .theme-toggle-button[aria-pressed='true'] .theme-toggle-thumb {
        transform: translateX(35px);
    }

    .theme-toggle-button[aria-pressed='false'] .theme-toggle-thumb {
        transform: translateX(0);
    }
</style>
