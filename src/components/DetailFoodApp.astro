---
import { getLocale } from '../i18n/config';
import { ui } from '../i18n/ui';
import makeupImage from '../assets/makeup.png';
import searchOneVideo from '../assets/Foods/videos/search-1.mp4';
import searchTwoVideo from '../assets/Foods/videos/search-2.mp4';

import homeImage from '../assets/Foods/Home - foods.png';
import searchImage from '../assets/Foods/searchFoods.png';
import productImage from '../assets/Foods/favorites - foods.png';
import cameraImage from '../assets/Foods/camera.png';
import cameraSuccessImage from '../assets/Foods/camera-success.png';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale].detailFood;

const experienceSections = [
    {
        ...t.experience.sections[0],
        video: searchOneVideo,
        variant: 'frame',
    },
    {
        ...t.experience.sections[1],
        video: searchTwoVideo,
        variant: 'phone',
    },
];

const screens = [
    {
        ...t.design.screens[0],
        src: homeImage.src,
    },
    {
        ...t.design.screens[1],
        src: searchImage.src,
    },
    {
        ...t.design.screens[2],
        src: cameraImage.src,
    },
    {
        ...t.design.screens[3],
        src: cameraSuccessImage.src,
    },
    {
        ...t.design.screens[4],
        src: productImage.src,
    },
];
---

<div class="detail">
    <section class="section intro-section">
        <span class="eyebrow">{t.intro.eyebrow}</span>
        <h1>{t.intro.title}</h1>
        <p class="lead">{t.intro.lead}</p>
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">{t.process.eyebrow}</span>
            <h2>{t.process.title}</h2>
        </div>

        <div class="steps">
            {t.process.steps.map((step) => (
                <div class="container-steps">
                    <h2>{step.title}</h2>
                    <p>{step.body}</p>
                </div>
            ))}
        </div>
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">{t.experience.eyebrow}</span>
            <h1>{t.experience.title}</h1>
        </div>

        <p class="lead">{t.experience.lead}</p>

        {experienceSections.map((item) => (
            <div class="final-gif">
                {item.variant === 'phone' ? (
                    <div class="iphone-mockup">
                        <div class="iphone-video-window">
                            <video class="final-video final-video-phone" style="max-width: 100%;" autoplay loop muted playsinline preload="metadata">
                                <source src={item.video} />
                            </video>
                        </div>
                        <img class="iphone-mockup-image" src={makeupImage.src} alt="" aria-hidden="true" />
                    </div>
                ) : (
                    <div class="final-video-frame">
                        <video class="final-video" autoplay loop muted playsinline preload="metadata">
                            <source src={item.video} />
                        </video>
                    </div>
                )}

                <div class="final-gif-copy">
                    <h2>{item.title}</h2>
                    <p>{item.body}</p>
                </div>
            </div>
        ))}
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">{t.design.eyebrow}</span>
            <h1>{t.design.title}</h1>
        </div>

        <p class="lead">{t.design.lead}</p>

        <div class="documentation documentation-design">
            <div class="design-grid">
                {screens.map((screen) => (
                    <div class="documentation-design-item food-screen-item">
                        <div class="food-screen-card">
                            <img src={screen.src} alt={screen.imageAlt} />
                            <div class="food-screen-copy">
                                <h2>{screen.title}</h2>
                                <p>{screen.body}</p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">{t.stack.eyebrow}</span>
            <h1>{t.stack.title}</h1>
        </div>

        <p class="lead">{t.stack.lead}</p>

        <div class="steps">
            {t.stack.cards.map((card) => (
                <div class="container-steps">
                    <h2>{card.title}</h2>
                    <p>{card.body}</p>
                </div>
            ))}
        </div>
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">{t.learning.eyebrow}</span>
            <h1>{t.learning.title}</h1>
        </div>

        <p class="lead">{t.learning.lead}</p>

        <div class="steps steps-two-by-two">
            {t.learning.cards.map((card) => (
                <div class="container-steps">
                    <h2>{card.title}</h2>
                    <p>{card.body}</p>
                </div>
            ))}
        </div>
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">{t.result.eyebrow}</span>
            <h1>{t.result.title}</h1>
        </div>

        <div class="text-card">
            {t.result.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
            ))}
        </div>
    </section>
</div>

<style>
    :global(body),
    :global(.detail-layout-content) {
        background: #3b0d0d;
    }

    .detail {
        --detail-bg: #5a1f20;
        --detail-surface: #6a292b;
        --detail-surface-secondary: #783436;
        --detail-text: #ffffff;
        --detail-muted: #e2d6d6;
        --detail-muted-secondary: #bda8a8;
        --detail-accent: #f07a68;
        --detail-border: rgba(255,255,255,0.08);
        --detail-shadow: 0 24px 70px rgba(0,0,0,.24);
        --detail-chip-bg: rgba(255,255,255,.06);
        --detail-lead: #ddd1d1;
        --detail-card-shadow: 0 18px 48px rgba(0,0,0,.18);
        --detail-card-hover-bg: #743234;
        --detail-card-hover-border: rgba(240,122,104,.34);
        --detail-final-panel-bg: #68292b;
        --detail-video-border: rgba(255,255,255,.10);
        --detail-radius: 30px;
        --detail-radius-sm: 22px;
        --detail-radius: 30px;
        --detail-radius-sm: 22px;
        width: 100%;
        max-width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        color: var(--detail-text);
        background: var(--detail-bg);
        padding-bottom: clamp(72px, 10vw, 120px);
    }

    .detail * {
        box-sizing: border-box;
    }

    .detail h1,
    .detail h2,
    .detail h3,
    .detail p,
    .eyebrow {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    }

    .detail h1 {
        margin: 0;
        max-width: 920px;
        font-size: clamp(2.5rem, 6vw, 5rem);
        letter-spacing: -0.065em;
        line-height: 0.96;
        font-weight: 760;
    }

    .detail h2 {
        margin: 0;
        font-size: clamp(1.5rem, 3vw, 2.35rem);
        letter-spacing: -0.04em;
        line-height: 1.05;
        font-weight: 720;
        color: var(--detail-text);
    }

    .detail h3 {
        margin: 0 0 18px;
        font-size: clamp(1.35rem, 2.2vw, 1.9rem);
        letter-spacing: -0.035em;
        line-height: 1.1;
        font-weight: 710;
    }

    .detail p {
        max-width: 1180px;
        margin: 0;
        color: var(--detail-muted);
        font-size: clamp(1rem, 1.1vw, 1.08rem);
        line-height: 1.78;
        letter-spacing: -0.012em;
    }

    .detail p + p {
        margin-top: 18px;
    }

    .section {
        width: min(100%, 1280px);
        margin: 0 auto;
        padding-top: clamp(72px, 9vw, 130px);
    }

    .intro-section {
        padding-top: clamp(56px, 7vw, 96px);
    }

    .section-heading {
        display: grid;
        gap: 14px;
        margin-bottom: clamp(28px, 5vw, 56px);
    }

    .eyebrow {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border: 1px solid var(--detail-border);
        border-radius: 999px;
        background: var(--detail-chip-bg);
        color: var(--detail-accent);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .lead {
        margin-top: 28px;
        width: 100%;
        max-width: 1050px;
        min-width: 0;
        font-size: clamp(1.18rem, 2vw, 1.55rem);
        line-height: 1.55;
        color: var(--detail-lead);
    }

    .section-heading + .lead {
        margin-top: 0;
    }

    .steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-top: 42px;
    }

    .steps-two-by-two {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .container-steps,
    .food-screen-card,
    .text-card {
        border: 1px solid var(--detail-border);
        border-radius: var(--detail-radius-sm);
        box-shadow: var(--detail-card-shadow);
    }

    .container-steps,
    .text-card {
        background: var(--detail-surface);
    }

    .container-steps {
        min-height: 100%;
        padding: clamp(24px, 4vw, 30px);
        transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }

    .container-steps h2 {
        margin-bottom: 14px;
        font-size: 1.35rem;
        letter-spacing: -0.035em;
    }

    .container-steps p {
        color: var(--detail-muted-secondary);
        font-size: 0.98rem;
        line-height: 1.68;
    }

    .container-steps:hover,
    .food-screen-card:hover {
        transform: translateY(-4px);
        border-color: var(--detail-card-hover-border);
        background: var(--detail-card-hover-bg);
    }

    .final-gif {
        display: grid;
        grid-template-columns: minmax(240px, 380px) minmax(0, 1fr);
        align-items: center;
        gap: clamp(28px, 6vw, 82px);
        padding: clamp(24px, 4vw, 42px);
        margin-top: 26px;
        border: 1px solid var(--detail-border);
        border-radius: var(--detail-radius);
        background: var(--detail-final-panel-bg);
        box-shadow: var(--detail-shadow);
    }

    .final-gif + .final-gif {
        margin-top: 32px;
    }

    .final-gif-copy {
        min-width: 0;
    }

    .final-gif-copy h2 {
        margin-bottom: 20px;
    }

    .final-gif-copy p {
        color: var(--detail-muted-secondary);
    }

    .final-video {
        display: flex;
        flex: 0 0 auto;
        width: min(100%, 340px);
        height: auto;
        aspect-ratio: 9 / 18.4;
        max-width: 60%;
        object-fit: contain;
        border: 1px solid var(--detail-video-border);
        border-radius: 22px;
        background: #000000;
    }

    .final-video-frame {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
    }

    .iphone-mockup {
        position: relative;
        width: min(100%, 330px);
        margin: 0 auto;
        aspect-ratio: 1024 / 1536;
    }

    .iphone-video-window {
        position: absolute;
        top: calc(2.6% + 7px);
        right: 19.3%;
        bottom: calc(4.5% + 2px);
        left: 19.3%;
        z-index: 1;
        overflow: hidden;
        border-radius: 34px;
        background: #000000;
    }

    .iphone-mockup-image {
        position: relative;
        z-index: 3;
        display: block;
        width: 100%;
        height: auto;
        pointer-events: none;
    }

    .final-video-phone {
        width: 100%;
        height: 100%;
        border: 0;
        border-radius: 0;
        object-fit: cover;
    }

    .documentation.documentation-design {
        width: 100%;
        margin: clamp(28px, 4vw, 44px) 0 clamp(62px, 7vw, 96px);
        display: flex;
        flex-direction: column;
        gap: clamp(24px, 5vw, 60px);
    }

    .design-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 18px;
        width: 100%;
    }

    .documentation-design-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        width: 100%;
        margin: 0;
        padding: 0;
        text-align: center;
    }

    .documentation-design-item img {
        width: 100%;
        max-width: none;
        height: auto;
        max-height: 460px;
        object-fit: contain;
    }

    .documentation-design-item h2 {
        font-size: 1rem;
        letter-spacing: -0.02em;
        color: var(--detail-text);
    }

    .food-screen-item {
        align-items: stretch;
        grid-column: span 2;
    }

    .food-screen-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: var(--detail-surface-secondary);
        overflow: hidden;
        transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }

    .food-screen-copy {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 18px 18px 22px;
        min-width: 0;
        text-align: left;
    }

    .food-screen-copy p {
        max-width: 100%;
        color: var(--detail-muted-secondary);
        font-size: 0.98rem;
        line-height: 1.68;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .text-card {
        padding: clamp(24px, 4vw, 42px);
    }

    .text-card p {
        max-width: 100%;
    }

    @media (max-width: 1180px) {
        .steps {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .design-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @media (max-width: 960px) {
        .final-gif {
            grid-template-columns: 1fr;
        }

        .design-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .food-screen-item {
            grid-column: span 1;
        }
    }

    @media (max-width: 720px) {
        .section {
            width: min(100%, 1180px);
            padding-top: 72px;
        }

        .steps,
        .steps-two-by-two,
        .design-grid {
            grid-template-columns: 1fr;
        }

        .final-gif {
            padding: 20px;
        }
    }

    @media (max-width: 560px) {
        .detail h1 {
            font-size: clamp(2.15rem, 13vw, 3.2rem);
        }

        .detail p {
            font-size: 0.96rem;
            line-height: 1.7;
        }

        .lead {
            font-size: 1.08rem;
        }

        .container-steps,
        .food-screen-card,
        .text-card {
            border-radius: 20px;
        }

        .steps,
        .design-grid {
            gap: 16px;
        }

        .container-steps,
        .text-card,
        .food-screen-copy {
            padding: 18px;
        }

        .final-video {
            width: 100%;
            border-radius: 18px;
        }
    }
</style>
