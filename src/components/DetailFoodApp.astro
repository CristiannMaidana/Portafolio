---
import { getLocale } from '../i18n/config';
import makeupImage from '../assets/makeup.png';
import searchOneVideo from '../assets/Foods/videos/search-1.mp4';
import searchTwoVideo from '../assets/Foods/videos/search-2.mp4';

import homeImage from '../assets/Foods/Home - foods.png';
import searchImage from '../assets/Foods/searchFoods.png';
import productImage from '../assets/Foods/favorites - foods.png';
import cameraImage from '../assets/Foods/camera.png';
import cameraSuccessImage from '../assets/Foods/camera.png';

const locale = getLocale(Astro.currentLocale);

const content = locale === 'en'
    ? {
        intro: {
            title: 'A project focused on technical learning.',
        },
        process: {
            steps: [
                {
                    title: 'Learn Expo',
                    body: 'Build a mobile app with Expo and React Native, learning project structure, screen navigation, and native integrations such as the camera.',
                },
                {
                    title: 'Use a public API',
                    body: 'Integrate the Open Food Facts API to retrieve real food product data, including search, barcode lookup, and external response handling.',
                },
                {
                    title: 'Build mobile flows',
                    body: 'Design a coherent experience connecting category browsing, search, favorites, and product scanning with a clear and natural user flow.',
                },
            ],
        },
    }
    : {
        intro: {
            title: 'Un proyecto enfocado en aprendizaje técnico.',
        },
        process: {
            steps: [
                {
                    title: 'Aprender Expo',
                    body: 'Construir una aplicación móvil utilizando Expo y React Native, aprendiendo la estructura de un proyecto, la navegación entre pantallas y la integración de funcionalidades nativas como la cámara.',
                },
                {
                    title: 'Usar una API pública',
                    body: 'Integrar la API de Open Food Facts para obtener información real de productos alimenticios, implementando búsquedas, consultas por código de barras y manejo de respuestas externas.',
                },
                {
                    title: 'Construir flujos mobile',
                    body: 'Diseñar una experiencia coherente conectando exploración por categorías, búsqueda, favoritos y escaneo de productos, priorizando una interacción clara y natural para el usuario.',
                },
            ],
        },
    };
---

<div class="detail">
    <section class="section intro-section">
        <span class="eyebrow">Contexto</span>
        <h1>{content.intro.title}</h1>

        <p class="lead">
            La app de alimentos fue desarrollada como proyecto universitario para practicar JavaScript, React Native y Expo mediante una aplicación móvil funcional. El objetivo fue integrar una API pública real, trabajar con navegación, búsqueda, cámara y escaneo de códigos de barras, aplicando una estructura de código más ordenada y cercana a un proyecto mobile real.
        </p>

        <div class="steps">
            {content.process.steps.map((step) => (
                <div class="container-steps">
                    <h2>{step.title}</h2>
                    <p>{step.body}</p>
                </div>
            ))}
        </div>
    </section>

    {/* Seccion de videos flujo de busqueda*/}
    <section class="section intro-section">
        <span class="eyebrow">Experiencia</span>
        <h1>Flujos principales de la aplicación</h1>

        <p class="lead">
            La aplicación ofrece dos recorridos principales según el contexto del usuario. Es posible explorar productos navegando por categorías, marcas o realizando una búsqueda manual, o acceder directamente al detalle escaneando el código de barras de un producto con la cámara del dispositivo.
        </p>

        <div class="final-gif">
            <div class="final-video-frame">
                <video class="final-video" autoplay loop muted preload="metadata">
                    <source src={searchOneVideo}/>
                </video>
            </div>

            <div class="final-gif-copy">
                <h2>Exploración manual</h2>
                <p>
                    El usuario puede descubrir productos comenzando desde la pantalla principal, explorando categorías, marcas o etiquetas destacadas. Al seleccionar una opción, la aplicación realiza una búsqueda automática, muestra los resultados disponibles y permite acceder al detalle completo de cada producto.
                </p>
            </div>
        </div>

        <div class="final-gif">
            <div class="iphone-mockup">
                <div class="iphone-video-window">
                    <video class="final-video final-video-phone" autoplay loop muted playsinline preload="metadata">
                        <source src={searchTwoVideo}/>
                    </video>
                </div>
                <img class="iphone-mockup-image" src={makeupImage.src} alt="" aria-hidden="true" />
            </div>

            <div class="final-gif-copy">
                <h2>Escaneo por camara</h2>
                <p>
                    Como alternativa a la búsqueda manual, la aplicación permite escanear el código de barras de un producto utilizando la cámara del dispositivo. Una vez detectado el código, se muestra una confirmación visual y el usuario puede acceder directamente a la pantalla de detalle.
                </p>
            </div>
        </div>
    </section>

    {/* Seccion de pantallas*/}
    <section class="section intro-section">
        <span class="eyebrow">Pantallas</span>
        <h1>Pantallas principales</h1>

        <p class="lead">
            La aplicación está compuesta por un conjunto de pantallas enfocadas en un flujo simple e intuitivo. Cada una cumple un propósito específico dentro de la experiencia, desde el descubrimiento de productos y la búsqueda de información hasta el escaneo de códigos de barras y la consulta del detalle nutricional. A continuación se presentan las vistas más representativas del proyecto y su función dentro del recorrido del usuario.
        </p>

        <div class="documentation documentation-design">
            <div class="design-grid">
                <div class="documentation-design-item food-screen-item">
                    <div class="food-screen-card">
                        <img src={homeImage.src} alt="Home screen">
                        <div class="food-screen-copy">
                            <h2>Home</h2>
                            <p>La pantalla principal actúa como punto de partida para explorar la aplicación. Desde ella el usuario puede descubrir productos navegando por categorías, marcas y etiquetas destacadas, facilitando el acceso rápido a diferentes búsquedas sin necesidad de escribir desde el inicio. Su diseño está orientado a promover el descubrimiento de contenido de forma simple y organizada.</p>
                        </div>
                    </div>
                </div>
                <div class="documentation-design-item food-screen-item">
                    <div class="food-screen-card">
                        <img src={searchImage.src} alt="Search screen">
                        <div class="food-screen-copy">
                            <h2>Search</h2>
                            <p>La pantalla de búsqueda permite encontrar productos mediante consultas por nombre, marca o categoría. Los resultados se obtienen en tiempo real desde la API de Open Food Facts e incorporan paginación automática para cargar más productos a medida que el usuario navega por la lista. Desde esta pantalla también es posible acceder al escáner de códigos de barras o abrir el detalle de cualquier producto encontrado.</p>
                        </div>
                    </div>
                </div>
                <div class="documentation-design-item food-screen-item">
                    <div class="food-screen-card">
                        <img src={cameraImage.src} alt="Camera screen">
                        <div class="food-screen-copy">
                            <h2>Camera</h2>
                            <p>La pantalla de escáner permite utilizar la cámara del dispositivo para leer códigos de barras de productos. Antes de realizar la detección, la interfaz guía al usuario mediante un marco de referencia y mensajes visuales que facilitan el posicionamiento del código, ofreciendo una experiencia clara y sencilla durante el proceso de escaneo.</p>
                        </div>
                    </div>
                </div>
                <div class="documentation-design-item food-screen-item">
                    <div class="food-screen-card">
                        <img src={cameraSuccessImage.src} alt="Camera success screen">
                        <div class="food-screen-copy">
                            <h2>Camera scanner</h2>
                            <p>Una vez reconocido el código de barras, la aplicación muestra una confirmación visual indicando que el producto fue identificado correctamente. Desde este estado, el usuario puede acceder directamente al detalle del producto o reiniciar el escaneo para consultar otro artículo, evitando interrupciones innecesarias durante el flujo.</p>
                        </div>
                    </div>
                </div>
                <div class="documentation-design-item food-screen-item">
                    <div class="food-screen-card">
                        <img src={productImage.src} alt="Product detail screen">
                        <div class="food-screen-copy">
                            <h2>Detail product</h2>
                            <p>La pantalla de detalle reúne toda la información disponible del producto en una única vista. Presenta datos generales como el nombre y la marca, junto con indicadores como Nutri-Score, Eco-Score y NOVA, además de la lista de ingredientes y la información nutricional. El contenido se organiza en bloques para facilitar una lectura rápida y una comparación sencilla entre productos.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>  

</div>

<style>
    .detail {
        --detail-bg: #3b0d0d;
        --detail-surface-secondary: #541818;
        --detail-text: #ffffff;
        --detail-muted: #d9d9d9;
        --detail-muted-secondary: #a8a8a8;
        --detail-accent: #e74c3c;
        --detail-hover: #f05a49;
        --detail-border: rgba(255, 255, 255, 0.08);
        --detail-card-shadow: 0 18px 48px rgba(0, 0, 0, 0.18);
        --detail-chip-bg: rgba(255, 255, 255, 0.05);
        --detail-card-hover-bg: #541818;
        --detail-card-hover-border: #f05a49;
        --detail-radius-sm: 22px;

        width: 100%;
        max-width: 100%;
        overflow-x: hidden;
        color: var(--detail-text);
        background: var(--detail-bg);
        padding-bottom: clamp(72px, 10vw, 120px);
    }

    .detail * {
        box-sizing: border-box;
    }

    .detail h1,
    .detail h2,
    .detail p,
    .eyebrow {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    }

    .detail h1 {
        margin: 0;
        max-width: 920px;
        font-size: clamp(2.5rem, 6vw, 5rem);
        letter-spacing: -0.065em;
        line-height: 0.96;
        font-weight: 760;
    }

    .detail h2 {
        margin: 0;
        font-size: clamp(1.5rem, 3vw, 2.35rem);
        letter-spacing: -0.04em;
        line-height: 1.05;
        font-weight: 720;
        color: var(--detail-text);
    }

    .detail p {
        max-width: 1180px;
        margin: 0;
        color: var(--detail-muted);
        font-size: clamp(1rem, 1.1vw, 1.08rem);
        line-height: 1.78;
        letter-spacing: -0.012em;
    }

    .section {
        width: min(100% - 32px, 1280px);
        margin: 0 auto;
        padding-top: clamp(72px, 9vw, 130px);
    }

    .intro-section {
        padding-top: clamp(56px, 7vw, 96px);
    }

    .eyebrow {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        margin-bottom: 18px;
        padding: 8px 14px;
        border: 1px solid var(--detail-border);
        border-radius: 999px;
        background: var(--detail-chip-bg);
        color: var(--detail-accent);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .lead {
        margin-top: 28px;
        width: 100%;
        max-width: 1050px;
        font-size: clamp(1.18rem, 2vw, 1.55rem);
        line-height: 1.55;
        color: var(--detail-muted);
    }

    .steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-top: 42px;
    }

    .container-steps {
        min-height: 100%;
        padding: clamp(20px, 3vw, 30px);
        background: var(--detail-surface-secondary);
        border: 1px solid var(--detail-border);
        border-radius: var(--detail-radius-sm);
        box-shadow: var(--detail-card-shadow);
        transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }

    .container-steps h2 {
        margin-bottom: 14px;
        font-size: 1.35rem;
        letter-spacing: -0.035em;
    }

    .container-steps p {
        color: var(--detail-muted-secondary);
        font-size: 0.98rem;
        line-height: 1.68;
    }

    .container-steps:hover {
        transform: translateY(-4px);
        border-color: var(--detail-card-hover-border);
        background: var(--detail-card-hover-bg);
    }

    .final-gif {
        display: grid;
        grid-template-columns: minmax(240px, 380px) 1fr;
        gap: clamp(24px, 5vw, 56px);
        align-items: center;
        margin-top: 48px;
        padding: clamp(20px, 4vw, 36px);
        background: var(--detail-surface-secondary);
        border: 1px solid var(--detail-border);
        border-radius: var(--detail-radius-sm);
        box-shadow: var(--detail-card-shadow);
    }

    .final-video {
        position: relative;
        z-index: 1;
        display: block;
        width: 70%;
        border-radius: 32px;
        overflow-x: auto;
    }

    .final-video-frame {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: clamp(16px, 2.8vw, 24px);
        max-width: 100%;
        border-radius: 52px;
        overflow: hidden;
    }

    .iphone-mockup {
        position: relative;
        width: min(100%, 330px);
        margin: 0 auto;
        aspect-ratio: 1024 / 1536;
    }

    .iphone-video-window {
        position: absolute;
        top: calc(2.6% + 7px);
        right: 19.3%;
        bottom: calc(4.5% + 2px);
        left: 19.3%;
        z-index: 1;
        overflow: hidden;
        border-radius: 34px;
        background: #000000;
    }

    .iphone-mockup-image {
        position: relative;
        z-index: 3;
        display: block;
        width: 100%;
        height: auto;
        pointer-events: none;
    }

    .final-video-phone {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        border-radius: 0;
        object-fit: cover;
        background: #000000;
    }

    .image img {
        height: clamp(210px, 31vw, 430px);
        width: auto;
        object-fit: contain;
        flex: 0 0 auto;
        filter: drop-shadow(0 20px 32px rgba(0, 0, 0, 0.28));
    }

    .final-gif-copy {
        display: grid;
        gap: 16px;
    }

    .final-gif-copy p {
        color: var(--detail-muted-secondary);
    }

    @media (max-width: 1180px) {
        .steps {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 820px) {
        .final-gif {
            grid-template-columns: 1fr;
        }

        .final-video {
            max-width: 320px;
            margin: 0 auto;
        }

        .final-video-frame {
            max-width: 320px;
            margin: 0 auto;
        }

        .iphone-mockup {
            max-width: 320px;
        }
    }

    .documentation-design {
        display: flex;
        flex-direction: column;
        margin-bottom: 0;
        gap: clamp(24px, 5vw, 60px);
    }

    .documentation-design-copy {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: clamp(24px, 4vw, 40px);
    }

    .documentation-design-text {
        margin: 0;
    }

    .documentation.documentation-design {
        display: flex;
        flex-direction: column;
    }

    .documentation {
        width: 100%;
        margin: clamp(28px, 4vw, 44px) 0 clamp(62px, 7vw, 96px);
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
        align-items: start;
        gap: clamp(22px, 4vw, 54px);
    }

    .design-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 18px;
        width: 100%;
    }

    .documentation-design-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        width: 100%;
        margin: 0;
        padding: 0;
        text-align: center;
    }

    .documentation-design-item img {
        width: 100%;
        max-width: none;
        height: auto;
        max-height: 460px;
        object-fit: contain;
    }

    .documentation-design-item h2 {
        font-size: 1rem;
        letter-spacing: -0.02em;
        color: var(--detail-muted);
    }

    .food-screen-item {
        align-items: stretch;
        grid-column: span 2;
    }

    .food-screen-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: var(--detail-surface-secondary);
        border: 1px solid var(--detail-border);
        border-radius: var(--detail-radius-sm);
        box-shadow: var(--detail-card-shadow);
        overflow: hidden;
        width: 100%;
    }

    .food-screen-copy {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 18px 16px 20px;
        min-width: 0;
        text-align: left;
    }

    .food-screen-copy p {
        max-width: 100%;
        color: var(--detail-muted-secondary);
        font-size: 0.98rem;
        line-height: 1.68;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    @media (max-width: 720px) {
        .steps {
            grid-template-columns: 1fr;
        }

        .design-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 560px) {
        .detail h1 {
            font-size: clamp(2.15rem, 13vw, 3.2rem);
        }

        .detail p {
            font-size: 0.96rem;
            line-height: 1.7;
        }

        .lead {
            font-size: 1.08rem;
        }

        .container-steps {
            padding: 18px;
            border-radius: 20px;
        }

        .final-video {
            max-width: 260px;
            border-radius: 22px;
        }

        .final-video-frame {
            max-width: 260px;
            padding: 14px;
            border-radius: 40px;
        }

        .iphone-mockup {
            max-width: 260px;
        }

        .iphone-video-window {
            border-radius: 34px;
        }
    }
</style>
