---
type TecnologyItem = {
    src: string;
    alt: string;
    label: string;
    imageClass?: string;
    nowrap?: boolean;
};

const {
    items,
    width = '100%'
} = Astro.props as {
    items: TecnologyItem[];
    width?: string;
};
---

<div class="tecnologys" style={`width:${width};`}>
    {items.map((item) => (
        <div class="tech-item">
            <div class="tecnology">
                <img class={item.imageClass} src={item.src} alt={item.alt} />
            </div>
            <p class={item.nowrap ? 'nowrap' : undefined}>{item.label}</p>
        </div>
    ))}
</div>

<style>
    .tecnologys {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 18px;
        max-width: 100%;
    }

    .tecnology img {
        width: 66.67px;
        height: 50px;
    }

    .tecnology img.icon-dart {
        width: 50px;
        height: 50px;
    }

    .tecnology img.icon-mapbox {
        width: 53.34px;
        height: 50px;
    }

    .tecnology img.icon-restapi {
        width: 50px;
        height: 50px;
    }

    .tecnology img.icon-postgres {
        width: 48.53px;
        height: 50px;
    }

    .tecnology img.icon-django {
        width: 39.26px;
        height: 50px;
    }

    .tecnology img.icon-java {
        width: 50px;
        height: 50px;
    }

    .tecnology img.icon-javascript {
        width: 43.15px;
        height: 50px;
    }

    .tecnology img.icon-expo {
        width: 50px;
        height: 50px;
    }

    .tecnology img.icon-reactnative {
        width: 90px;
        height: 50px;
    }

    .tecnology {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 62px;
        height: 62px;
        border: 1px solid var(--portfolio-border);
        border-radius: 10px;
        transition: transform .3s;
    }

    .tech-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 78px;
        text-align: center;
    }

    .tech-item:hover .tecnology {
        transform: translateY(-4px);
    }

    .tech-item:hover p {
        color: var(--portfolio-accent);
    }

    .tecnology + p {
        margin: 6px 0 0;
        transition: color .3s;
    }

    .nowrap {
        white-space: nowrap;
    }

    @media (max-width: 1100px) {
        .tecnologys {
            gap: 14px;
        }
    }

    @media (max-width: 768px) {
        .tecnologys {
            gap: 14px;
        }

        .tecnology {
            width: 56px;
            height: 56px;
        }

        .tecnology img {
            width: 52px;
            height: 40px;
        }

        .tecnology img.icon-dart,
        .tecnology img.icon-restapi,
        .tecnology img.icon-java,
        .tecnology img.icon-expo {
            width: 40px;
            height: 40px;
        }

        .tecnology img.icon-reactnative {
            width: 90px;
            height: 40px;
        }

        .tecnology img.icon-mapbox {
            width: 44px;
            height: 40px;
        }

        .tecnology img.icon-postgres {
            width: 39px;
            height: 40px;
        }

        .tecnology img.icon-django {
            width: 31px;
            height: 40px;
        }

        .tecnology img.icon-javascript {
            width: 34.52px;
            height: 40px;
        }

        .tech-item {
            width: 68px;
        }
    }
</style>
