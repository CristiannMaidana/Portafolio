---
import Tecnologys from './tecnologys.astro';

type TecnologyItem = {
    src: string;
    alt: string;
    label: string;
    imageClass?: string;
    nowrap?: boolean;
};

type ProjectLink = {
    label: string;
    href?: string;
    variant?: 'primary' | 'secundary';
    target?: string;
    rel?: string;
};

type ProjectImage = {
    src: string;
    alt: string;
    imageClass?: string;
};

const {
    description,
    technologies,
    links,
    images,
    imageContainerColor = 'var(--portfolio-showcase-bg)',
    showcaseShadowTop = 'var(--portfolio-showcase-shadow-top)',
    showcaseShadowBottom = 'var(--portfolio-showcase-shadow-bottom)'
} = Astro.props as {
    description: string[];
    technologies: TecnologyItem[];
    links: ProjectLink[];
    images: ProjectImage[];
    imageContainerColor?: string;
    showcaseShadowTop?: string;
    showcaseShadowBottom?: string;
};
---

<div class="project-content">
    <div class="text">
        <slot />
        <div class="project-copy">
            {description.map((paragraph) => (
                <p>{paragraph}</p>
            ))}
        </div>
        <Tecnologys items={technologies} />
        <div class="buttons">
            {links.map((link) =>
                link.href ? (
                    <a
                        class={`bt ${link.variant ?? 'secundary'}`}
                        href={link.href}
                        target={link.target}
                        rel={link.rel}
                    >
                        {link.label}
                    </a>
                ) : (
                    <button class={`bt ${link.variant ?? 'secundary'}`} type="button">
                        {link.label}
                    </button>
                )
            )}
        </div>
    </div>
    <div class="image">
        <div
            class="app-showcase"
            style={`--image-container-color: ${imageContainerColor}; --showcase-shadow-top: ${showcaseShadowTop}; --showcase-shadow-bottom: ${showcaseShadowBottom};`}
        >
            {images.map((image) => (
                <img class={`app-image ${image.imageClass ?? ''}`.trim()} src={image.src} alt={image.alt} />
            ))}
        </div>
    </div>
</div>

<style>
    .project-content {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 32px;
        width: 100%;
    }

    .text {
        width: 100%;
        min-width: 0;
    }

    .image {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        min-width: 0;
    }

    .project-copy {
        width: 110%;
    }

    .buttons {
        display: flex;
        gap: 10px;
        margin-top: 30px;
    }

    .bt {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 16px 22px;
        border-radius: 16px;
        border: 1px solid transparent;
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 16px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: background-color .3s, color .3s, border-color .3s, transform .3s;
    }

    .bt.primary {
        background: linear-gradient(135deg, var(--portfolio-accent-start), var(--portfolio-accent-end));
        color: var(--portfolio-button-text);
    }

    .bt.secundary {
        border-color: var(--portfolio-input-border);
        color: var(--portfolio-text);
        background: var(--portfolio-surface);
    }

    .bt:hover {
        transform: translateY(-4px);
    }

    .bt.secundary:hover {
        background: var(--portfolio-button-hover);
    }

    .app-showcase {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: 12px;
        width: min(100%, 560px);
        min-height: 450px;
        overflow: hidden;
        border: 1px solid var(--portfolio-showcase-border);
        border-radius: 22px;
        padding: 28px 22px;
        box-sizing: border-box;
        background: var(--image-container-color, var(--portfolio-showcase-bg));
        box-shadow:
            inset 0 2px 0 var(--portfolio-showcase-highlight),
            inset 0 -18px 28px var(--showcase-shadow-top, var(--portfolio-showcase-shadow-top)),
            0 18px 35px var(--showcase-shadow-bottom, var(--portfolio-showcase-shadow-bottom));
    }

    .app-image {
        width: 31%;
        max-width: 180px;
        height: auto;
        object-fit: contain;
        margin-bottom: 30px;
    }

    .app-image.middle {
        transform: translateY(clamp(178px, 8vw, 148px));
    }

    p {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(1rem, 1.4vw, 1.25rem);
        color: var(--portfolio-muted);
    }

    @media (max-width: 1360px) {
        .project-content {
            gap: 24px;
        }

        .app-showcase {
            padding: 24px 18px;
        }

        .buttons {
            margin-top: 24px;
        }
    }

    @media (max-width: 1200px) {
        .app-showcase {
            padding: 20px 16px;
        }
    }

    @media (max-width: 1024px) {
        .project-content {
            flex-direction: column;
            align-items: stretch;
        }

        .project-copy {
            width: 100%;
        }

        .image {
            justify-content: center;
        }

        .app-showcase {
            width: 100%;
            min-height: 0;
            aspect-ratio: 16 / 10;
        }

        .app-image {
            width: 29%;
            max-width: none;
        }
    }

    @media (max-width: 768px) {
        .project-content {
            gap: 24px;
        }

        .app-showcase {
            padding: 70px 12px;
            aspect-ratio: 1 / 1;
        }

        .app-image {
            width: 30%;
        }

        .app-image.middle {
            transform: translateY(clamp(206px, 9vw, 96px));
        }

        .buttons {
            flex-direction: column;
        }

        .bt {
            width: 100%;
            height: 48px;
            padding: 0;
        }
    }
</style>
