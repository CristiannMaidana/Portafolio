---
import calendarImage from '../assets/EcoUshuaia/forDetails/calendar.png';
import editDataImage from '../assets/EcoUshuaia/forDetails/edit-data.png';
import mapImage from '../assets/EcoUshuaia/forDetails/map-end.png';
import newsDetailImage from '../assets/EcoUshuaia/forDetails/news-detail.png';
import optionFilterImage from '../assets/EcoUshuaia/forDetails/option-filter.png';
import settingsImage from '../assets/EcoUshuaia/forDetails/settings.png';
import singupImage from '../assets/EcoUshuaia/forDetails/singup.png';

import requeriments from '../assets/EcoUshuaia/forDetails/documentation/Requerimientos.png'
import caserUse from '../assets/EcoUshuaia/forDetails/documentation/CasosDeUso.png'
import dataBase from '../assets/EcoUshuaia/forDetails/documentation/DataBase.png'
import loginImage from '../assets/EcoUshuaia/forDetails/login.png'
import homeImage from '../assets/EcoUshuaia/forDetails/home.png'
import calendarVideo from '../assets/EcoUshuaia/forDetails/video/calendarGif.mp4'
import mapVideo from '../assets/EcoUshuaia/forDetails/video/mapGif.mp4'
import settingVideo from '../assets/EcoUshuaia/forDetails/video/settingsGif.mp4'
import { getLocale } from '../i18n/config';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale].detailEco;

const detailImages = [
    { src: calendarImage.src, alt: t.imageAlts[0] },
    { src: editDataImage.src, alt: t.imageAlts[1] },
    { src: mapImage.src, alt: t.imageAlts[2] },
    { src: newsDetailImage.src, alt: t.imageAlts[3] },
    { src: optionFilterImage.src, alt: t.imageAlts[4] },
    { src: settingsImage.src, alt: t.imageAlts[5] },
    { src: singupImage.src, alt: t.imageAlts[6] }
];
---
<div class="detail">
    <div class="image">
        {detailImages.map((image) => (
            <img src={image.src} alt={image.alt} />
        ))}
    </div>

    <section class="section intro-section">
        <span class="eyebrow">{t.intro.eyebrow}</span>
        <h1>{t.intro.title}</h1>
        <p class="lead">{t.intro.lead}</p>
    </section>

    <section class="section">
        <span class="eyebrow">{t.context.eyebrow}</span>
        <h3>{t.context.title}</h3>
        {t.context.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
        ))}
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">{t.process.eyebrow}</span>
            <h2>{t.process.title}</h2>
        </div>

        <div class="steps">
            {t.process.steps.map((step) => (
                <div class="container-steps">
                    <h2>{step.title}</h2>
                    <p>{step.body}</p>
                </div>
            ))}
        </div>
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">{t.firstSteps.eyebrow}</span>
            <h1>{t.firstSteps.title}</h1>
        </div>

        <h2>{t.firstSteps.requirements.title}</h2>
        <p>{t.firstSteps.requirements.paragraph}</p>

        <div class="documentation">
            <img src={requeriments.src} alt={t.firstSteps.requirements.imageAlt} class="documentation img req">
            <div class="experience-card">
                <h3>{t.firstSteps.requirements.experienceTitle}</h3>
                <ul class="experience-list">
                    {t.firstSteps.requirements.experience.map((item) => (
                        <li>{item}</li>
                    ))}
                </ul>
            </div>
        </div>

        <h2>{t.firstSteps.useCases.title}</h2>
        <p>{t.firstSteps.useCases.paragraph}</p>

        <div class="documentation">
            <img src={caserUse.src} alt={t.firstSteps.useCases.imageAlt} class="documentation img req">
            <div class="experience-card" style="margin-top: 44px;">
                <h3>{t.firstSteps.useCases.experienceTitle}</h3>
                <ul class="experience-list">
                    {t.firstSteps.useCases.experience.map((item) => (
                        <li>{item}</li>
                    ))}
                </ul>
            </div>
        </div>

        <h2>{t.firstSteps.database.title}</h2>
        <p>{t.firstSteps.database.paragraph}</p>

        <div class="documentation" style="display: flex; flex-direction: column; align-items: flex-start; gap: 24px;">
            <img src={dataBase.src} alt={t.firstSteps.database.imageAlt} class="documentation img req">
            <div class="experience-card" style="width: min(100%, 105800px);">
                <h3>{t.firstSteps.database.experienceTitle}</h3>
                {t.firstSteps.database.experience.map((paragraph) => (
                    <p>{paragraph}</p>
                ))}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">{t.design.eyebrow}</span>
            <h1>{t.design.title}</h1>
        </div>

        <div class="documentation documentation-design">

            <div class="design-grid">
                <div class="documentation-design-item">
                    <img src={loginImage.src} alt={t.design.screens[0]}>
                    <h2>{t.design.screens[0]}</h2>
                </div>
                <div class="documentation-design-item">
                    <img src={singupImage.src} alt={t.design.screens[1]}>
                    <h2>{t.design.screens[1]}</h2>
                </div>
                <div class="documentation-design-item">
                    <img src={homeImage.src} alt={t.design.screens[2]}>
                    <h2>{t.design.screens[2]}</h2>
                </div>
                <div class="documentation-design-item">
                    <img src={calendarImage.src} alt={t.design.screens[3]}>
                    <h2>{t.design.screens[3]}</h2>
                </div>
                <div class="documentation-design-item">
                    <img src={mapImage.src} alt={t.design.screens[4]}>
                    <h2>{t.design.screens[4]}</h2>
                </div>
                <div class="documentation-design-item">
                    <img src={settingsImage.src} alt={t.design.screens[5]}>
                    <h2>{t.design.screens[5]}</h2>
                </div>
            </div>

            <div class="documentation-design-copy glass-card">
                {t.design.paragraphs.map((paragraph) => (
                    <p class="documentation-design-text">{paragraph}</p>
                ))}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">{t.result.eyebrow}</span>
            <h1>{t.result.title}</h1>
        </div>

        <div class="final-gif">
            <video class="final-video" src={calendarVideo} autoplay loop muted playsinline></video>
            <div class="final-gif-copy">
                <h2>{t.result.sections[0].title}</h2>
                {t.result.sections[0].paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                ))}
            </div>
        </div>

        <div class="final-gif">
            <video class="final-video" src={mapVideo} autoplay loop muted playsinline></video>
            <div class="final-gif-copy">
                <h2>{t.result.sections[1].title}</h2>
                {t.result.sections[1].paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                ))}
            </div>
        </div>

        <div class="final-gif">
            <video class="final-video" src={settingVideo} autoplay loop muted playsinline></video>
            <div class="final-gif-copy">
                <h2>{t.result.sections[2].title}</h2>
                {t.result.sections[2].paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                ))}
            </div>
        </div>
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">{t.learning.eyebrow}</span>
            <h1>{t.learning.title}</h1>
        </div>

        <div class="text-card">
            {t.learning.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
            ))}
        </div>
    </section>

    <section class="section">
        <div class="section-heading">
            <span class="eyebrow">{t.stack.eyebrow}</span>
            <h1>{t.stack.title}</h1>
        </div>

        <div class="text-card">
            {t.stack.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
            ))}
        </div>

        <div class="technology-grid">
            {t.stack.cards.map((card) => (
                <div class="technology-card">
                    <h3>{card.title}</h3>
                    <p>{card.body}</p>
                </div>
            ))}
        </div>
    </section>
</div>

<style>
    .detail {
        --detail-bg: var(--detail-page-bg-end, #f5f7f4);
        --detail-surface: var(--detail-surface-theme, rgba(255, 255, 255, 0.76));
        --detail-text: var(--detail-text-theme, #1d1d1f);
        --detail-muted: var(--detail-muted-theme, #667064);
        --detail-eco-dark: var(--detail-accent-theme, #3f7f4f);
        --detail-border: var(--detail-border-theme, rgba(83, 125, 89, 0.16));
        --detail-shadow: var(--detail-shadow-theme, 0 24px 70px rgba(42, 78, 48, 0.08));
        --detail-chip-bg: var(--detail-chip-bg-theme, rgba(255, 255, 255, 0.66));
        --detail-lead: var(--detail-lead-theme, #475146);
        --detail-card-shadow: var(--detail-card-shadow-theme, 0 18px 48px rgba(43, 74, 46, 0.055));
        --detail-card-hover-bg: var(--detail-card-hover-bg-theme, rgba(255, 255, 255, 0.88));
        --detail-card-hover-border: var(--detail-card-hover-border-theme, rgba(83, 125, 89, 0.28));
        --detail-final-panel-bg: var(--detail-final-panel-bg-theme, linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(241, 248, 239, 0.72)));
        --detail-image-bg: var(--detail-image-bg-theme, linear-gradient(135deg, rgba(238, 250, 235, 0.94), rgba(217, 241, 215, 0.9)), radial-gradient(circle at 30% 30%, rgba(150, 222, 147, 0.8), transparent 24rem));
        --detail-video-border: var(--detail-video-border-theme, rgba(0, 0, 0, 0.88));
        --detail-radius: 30px;
        --detail-radius-sm: 22px;
        width: 100%;
        max-width: 100%;
        overflow-x: hidden;
        color: var(--detail-text);
    }

    .detail * {
        box-sizing: border-box;
    }

    .detail h1,
    .detail h2,
    .detail h3,
    .detail p,
    .eyebrow {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    }

    .detail h1 {
        margin: 0;
        max-width: 920px;
        font-size: clamp(2.5rem, 6vw, 5rem);
        letter-spacing: -0.065em;
        line-height: 0.96;
        font-weight: 760;
    }

    .detail h2 {
        margin: 0;
        font-size: clamp(1.5rem, 3vw, 2.35rem);
        letter-spacing: -0.04em;
        line-height: 1.05;
        font-weight: 720;
    }

    .detail h3 {
        margin: 0 0 18px;
        font-size: clamp(1.35rem, 2.2vw, 1.9rem);
        letter-spacing: -0.035em;
        line-height: 1.1;
        font-weight: 710;
    }

    .detail p {
        max-width: 1180px;
        margin: 0;
        color: var(--detail-muted);
        font-size: clamp(1rem, 1.1vw, 1.08rem);
        line-height: 1.78;
        letter-spacing: -0.012em;
    }

    .detail p + p {
        margin-top: 18px;
    }

    .section {
        width: min(100%, 1280px);
        margin: 0 auto;
        padding-top: clamp(72px, 9vw, 130px);
    }

    .intro-section {
        padding-top: clamp(56px, 7vw, 96px);
    }

    .section-heading {
        display: grid;
        gap: 14px;
        margin-bottom: clamp(28px, 5vw, 56px);
    }

    .eyebrow {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border: 1px solid var(--detail-border);
        border-radius: 999px;
        background: var(--detail-chip-bg);
        color: var(--detail-eco-dark);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        backdrop-filter: blur(18px);
    }

    .lead {
        margin-top: 28px;
        width: 100%;
        max-width: 1050px;
        min-width: 0;
        font-size: clamp(1.18rem, 2vw, 1.55rem);
        line-height: 1.55;
        color: var(--detail-lead);
    }

    .steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .container-steps,
    .technology-card,
    .text-card,
    .experience-card,
    .glass-card {
        background: var(--detail-surface);
        border: 1px solid var(--detail-border);
        border-radius: var(--detail-radius-sm);
        box-shadow: var(--detail-card-shadow);
        backdrop-filter: blur(20px);
    }

    .container-steps {
        min-height: 100%;
        padding: clamp(1px, 3vw, 30px);
        transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }

    .container-steps h2 {
        margin-bottom: 14px;
        font-size: 1.35rem;
        letter-spacing: -0.035em;
    }

    .container-steps p,
    .experience-card p,
    .technology-card p {
        font-size: 0.98rem;
        line-height: 1.68;
    }

    .container-steps:hover,
    .technology-card:hover {
        transform: translateY(-4px);
        border-color: var(--detail-card-hover-border);
        background: var(--detail-card-hover-bg);
    }

    .documentation {
        width: 100%;
        margin: clamp(28px, 4vw, 44px) 0 clamp(62px, 7vw, 96px);
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
        align-items: start;
        gap: clamp(22px, 4vw, 54px);
    }

    .documentation img {
        display: block;
        width: 100%;
        max-width: 700px;
        height: auto;
        object-fit: contain;
    }

    .documentation img.req {
        border: 1px solid var(--detail-border);
        border-radius: var(--detail-radius);
    }

    .documentation[style*='flex-direction: column'] img.req {
        width: min(100%, 1080px);
        max-width: 1080px;
        margin: 0 auto;
    }

    .experience-card {
        padding: clamp(24px, 4vw, 38px);
    }

    .experience-card h3 {
        margin-bottom: 18px;
    }

    .experience-list {
        margin: 0;
        padding-left: 18px;
        color: var(--detail-muted);
    }

    .experience-list li + li {
        margin-top: 10px;
    }

    .documentation-design {
        display: flex;
        flex-direction: column;
        margin-bottom: 0;
        gap: clamp(24px, 5vw, 60px);
    }

    .documentation-design-copy {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: clamp(24px, 4vw, 40px);
    }

    .documentation-design-text {
        margin: 0;
    }

    .design-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 18px;
        width: 100%;
    }

    .documentation-design-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        width: 100%;
        margin: 0;
        padding: 0;
        text-align: center;
    }

    .documentation-design-item img {
        width: 100%;
        max-width: none;
        height: auto;
        max-height: 360px;
        object-fit: contain;
    }

    .documentation-design-item h2 {
        font-size: 1rem;
        letter-spacing: -0.02em;
        color: var(--detail-muted);
    }

    .final-gif {
        display: grid;
        grid-template-columns: minmax(240px, 380px) minmax(0, 1fr);
        align-items: center;
        gap: clamp(28px, 6vw, 82px);
        padding: clamp(24px, 4vw, 42px);
        margin-top: 26px;
        border: 1px solid var(--detail-border);
        border-radius: var(--detail-radius);
        background: var(--detail-final-panel-bg);
        box-shadow: var(--detail-shadow);
    }

    .final-gif + .final-gif {
        margin-top: 32px;
    }

    .final-gif-copy {
        min-width: 0;
    }

    .final-gif-copy h2 {
        margin-bottom: 20px;
    }

    .final-video {
        display: flex;
        flex: 0 0 auto;
        width: min(100%, 340px);
        height: auto;
        aspect-ratio: 9 / 18.4;
        max-width: 100%;
        object-fit: contain;
        border: 1px solid var(--detail-video-border);
        border-radius: 22px;
    }

    .text-card {
        padding: clamp(24px, 4vw, 42px);
    }

    .text-card p {
        max-width: 100%;
    }

    .technology-grid {
        margin-top: 28px;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 18px;
        align-items: stretch;
    }

    .technology-card {
        padding: clamp(2px, 3vw, 20px);
        transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }

    .technology-card h3 {
        margin: 0 0 14px;
        text-align: left;
        font-size: 1.08rem;
        letter-spacing: -0.03em;
        color: var(--detail-text);
    }

    .technology-card p {
        margin: 0;
        overflow-wrap: anywhere;
        word-break: break-word;
        font-size: 13px;
    }

    .image {
        display: flex;
        flex-direction: row;
        justify-content: space-around;
        align-items: center;
        background: var(--detail-image-bg);
        width: 100%;
        min-height: 300px;
        padding: 24px;
        overflow-x: auto;
        gap: 24px;
    }

    .image img {
        height: clamp(210px, 31vw, 430px);
        width: auto;
        object-fit: contain;
        flex: 0 0 auto;
    }

    .image img:nth-child(1),
    .image img:nth-child(4),
    .image img:nth-child(7) {
        transform: translateY(-18px);
    }

    .image img:nth-child(2),
    .image img:nth-child(5) {
        transform: translateY(20px);
    }

    .image img:nth-child(3),
    .image img:nth-child(6) {
        transform: translateY(-6px);
    }

    @media (max-width: 1180px) {
        .steps,
        .technology-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .documentation-design {
            display: flex;
            flex-direction: column;
        }
    }

    @media (max-width: 960px) {
        .documentation,
        .final-gif {
            grid-template-columns: 1fr;
        }

        .design-grid {
            grid-template-columns: repeat(6, minmax(0, 1fr));
        }
    }

    @media (max-width: 720px) {
        .section {
            width: min(100%, 1180px);
            padding-top: 72px;
        }

        .image {
            justify-content: flex-start;
            padding: 18px;
            min-height: 0;
        }

        .image img:nth-child(1),
        .image img:nth-child(2),
        .image img:nth-child(3),
        .image img:nth-child(4),
        .image img:nth-child(5),
        .image img:nth-child(6),
        .image img:nth-child(7) {
            transform: none;
        }

        .steps,
        .technology-grid {
            grid-template-columns: 1fr;
        }

        .design-grid {
            grid-template-columns: repeat(6, minmax(0, 1fr));
        }

        .documentation-design-item {
            width: 100%;
        }

        .final-gif {
            padding: 20px;
        }
    }

    @media (max-width: 560px) {
        .detail h1 {
            font-size: clamp(2.15rem, 13vw, 3.2rem);
        }

        .detail p {
            font-size: 0.96rem;
            line-height: 1.7;
        }

        .lead {
            font-size: 1.08rem;
        }

        .container-steps,
        .technology-card,
        .text-card,
        .experience-card,
        .glass-card {
            border-radius: 20px;
        }

        .final-gif,
        .documentation,
        .steps,
        .design-grid,
        .technology-grid {
            gap: 16px;
        }

        .container-steps,
        .technology-card,
        .text-card,
        .experience-card,
        .documentation-design-copy {
            padding: 18px;
        }

        .final-video {
            width: 100%;
            border-radius: 18px;
        }
    }
</style>
