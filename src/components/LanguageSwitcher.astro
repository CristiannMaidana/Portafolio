---
import { getLocale, getSwitchLocalePath, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const currentPath = Astro.props.path ?? '/';
const className = Astro.props.className ?? '';
const options: Locale[] = ['es', 'en'];
---

<div class={`language-switcher ${className}`.trim()}>
    <details>
        <summary aria-label={ui[locale].language.label}>
            <svg class="summary-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Z" />
                <path d="M2 12h20" />
                <path d="M12 2a15.3 15.3 0 0 1 0 20" />
                <path d="M12 2a15.3 15.3 0 0 0 0 20" />
            </svg>
            <svg class="summary-chevron" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m7 10 5 5 5-5" />
            </svg>
        </summary>

        <div class="language-menu">
            {options.map((option) => (
                <a
                    href={getSwitchLocalePath(option, currentPath)}
                    class={`language-option ${option === locale ? 'is-active' : ''}`.trim()}
                    data-language-option={option}
                >
                    {ui[option].language.selfLabel}
                </a>
            ))}
        </div>
    </details>
</div>

<style>
    .language-switcher {
        position: relative;
    }

    details {
        position: relative;
    }

    summary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        width: 52px;
        height: 42px;
        padding: 0 10px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        color: inherit;
        cursor: pointer;
        list-style: none;
        transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary:hover,
    details[open] summary {
        background: rgba(255, 255, 255, 0.14);
        color: inherit;
        transform: translateY(-1px);
    }

    .summary-icon,
    .summary-chevron {
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .summary-icon {
        width: 18px;
        height: 18px;
        stroke-width: 1.8;
    }

    .summary-chevron {
        width: 14px;
        height: 14px;
        stroke-width: 2.2;
    }

    .language-menu {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        min-width: 140px;
        display: grid;
        gap: 6px;
        padding: 10px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 18px;
        background: rgba(20, 20, 20, 0.88);
        box-shadow: 0 18px 30px rgba(0, 0, 0, 0.22);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .language-option {
        display: block;
        border-radius: 12px;
        padding: 10px 12px;
        background: transparent;
        color: #f4f8f3;
        font: inherit;
        text-align: left;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .language-option:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
    }

    .language-option.is-active {
        background: rgba(255, 255, 255, 0.12);
    }
</style>
