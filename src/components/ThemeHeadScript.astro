<script is:inline>
    (() => {
        const storageKey = 'preferred-theme';
        const cookieKey = 'preferred-theme';
        const validThemes = ['light', 'dark'];
        const readCookie = () => {
            const match = document.cookie.match(/(?:^|; )preferred-theme=([^;]+)/);
            return match ? decodeURIComponent(match[1]) : null;
        };

        let theme = 'light';

        try {
            const storedTheme = localStorage.getItem(storageKey);

            if (storedTheme && validThemes.includes(storedTheme)) {
                theme = storedTheme;
            } else {
                const cookieTheme = readCookie();

                if (cookieTheme && validThemes.includes(cookieTheme)) {
                    theme = cookieTheme;
                } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    theme = 'dark';
                }
            }
        } catch {
            const cookieTheme = readCookie();
            theme = cookieTheme && validThemes.includes(cookieTheme)
                ? cookieTheme
                : window.matchMedia('(prefers-color-scheme: dark)').matches
                    ? 'dark'
                    : 'light';
        }

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
    })();
</script>
