---
---
<div class="contact-page">
    <h3>Contacto</h3>
    <h1>Construyamos algo juntos</h1>
    <form class="contact-form">
        <div class="inputs">
            <input type="text" name="nombre" placeholder="Nombre" />
            <input type="email" name="email" placeholder="Email" required />
        </div>
        <div class="msg">
            <textarea name="mensaje" placeholder="Mensaje"></textarea>
        </div>
        <button type="submit">Enviar mensaje</button>
    </form>
</div>

<style>
    .contact-page{
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        text-align: center;
        border: 1px solid black;
        border-radius: 64px;
        padding: 30px 100px 50px;
        margin: 0 60px 0px; 
        box-sizing: border-box;
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 976px;
    }

    .inputs{
        display: flex;
        flex-direction: row;
        gap: 16px;
        margin-top: 24px;
        width: 100%;
    }

    .inputs input {
        width: 480px;
        max-width: 100%;
        flex: 1 1 0;
        min-width: 0;
        padding: 14px 18px;
        border: 1px solid #d0d7de;
        border-radius: 14px;
        font-size: 16px;
        color: #14191c;
        background: #ffffff;
        box-sizing: border-box;
    }

    .inputs input:focus {
        outline: none;
        border-color: #66e3ff;
    }

    .msg {
        margin-top: 16px;
        width: 100%;
    }

    .msg textarea {
        width: 976px;
        max-width: 100%;
        display: block;
        height: 340px;
        padding: 14px 18px;
        border: 1px solid #d0d7de;
        border-radius: 14px;
        font-size: 16px;
        color: #14191c;
        background: #ffffff;
        box-sizing: border-box;
        resize: none;
        font-family: inherit;
    }

    .msg textarea:focus {
        outline: none;
        border-color: #66e3ff;
    }

    .inputs input[type='email']:not(:placeholder-shown):invalid {
        border-color: #ff6b6b;
    }

    .inputs input[type='email']:not(:placeholder-shown):valid {
        border-color: #5ec26a;
    }

    button {
        width: 976px;
        max-width: 100%;
        margin-top: 20px;
        padding: 16px 22px;
        border: 1px solid transparent;
        border-radius: 16px;
        background: linear-gradient(135deg, #66e3ff, #7c5cff);
        color: #0b0d10;
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: transform .3s, opacity .3s;
    }

    button:hover {
        transform: translateY(-2px);
        opacity: 0.96;
    }

    h1 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 1;
        color: black;
    }

    h3 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(1.25rem, 2.5vw, 1.875rem);
        color: #85e7fb;
        margin-bottom: -20px;
    }

    @media (max-width: 1200px) {
        .contact-page {
            padding-left: 48px;
            padding-right: 48px;
            margin-left: 24px;
            margin-right: 24px;
        }
    }

    @media (max-width: 768px) {
        .contact-page {
            padding-left: 20px;
            padding-right: 20px;
            margin-left: 0;
            margin-right: 0;
        }

        .inputs {
            flex-direction: column;
        }
    }
</style>
