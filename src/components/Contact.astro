---
import { getLocale } from '../i18n/config';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale].contact;
---
<div class="contact-page">
    <h3>{t.eyebrow}</h3>
    <h1>{t.title}</h1>
    <form class="contact-form" name="contact" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="contact" />
        <div class="inputs">
            <label class="field">
                <span class="field-text">{t.fields.name.label}</span>
                <input type="text" name="name" placeholder={t.fields.name.placeholder} required />
            </label>
            <label class="field">
                <span class="field-text">{t.fields.email.label}</span>
                <input type="email" name="email" placeholder={t.fields.email.placeholder} required />
            </label>
        </div>
        <div class="msg">
            <label class="field field-message">
                <span class="field-text">{t.fields.message.label}</span>
                <textarea name="message" placeholder={t.fields.message.placeholder} required></textarea>
            </label>
        </div>
        <button type="submit">{t.submit}</button>
    </form>
</div>

<style>
    .contact-page{
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        text-align: center;
        border: 1px solid var(--portfolio-border);
        border-radius: 64px;
        padding: 30px 100px 50px;
        margin: 0 60px 0px; 
        box-sizing: border-box;
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 976px;
    }

    .field {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        width: 100%;
    }

    .field-text {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: var(--portfolio-heading);
        text-align: left;
    }

    .inputs{
        display: flex;
        flex-direction: row;
        gap: 16px;
        margin-top: 24px;
        width: 100%;
    }

    .inputs input {
        width: 480px;
        max-width: 100%;
        flex: 1 1 0;
        min-width: 0;
        padding: 14px 18px;
        border: 1px solid var(--portfolio-input-border);
        border-radius: 14px;
        font-size: 16px;
        color: var(--portfolio-text);
        background: var(--portfolio-surface);
        box-sizing: border-box;
    }

    .inputs input:focus {
        outline: none;
        border-color: var(--portfolio-accent-start);
    }

    .msg {
        margin-top: 16px;
        width: 100%;
    }

    .field-message {
        width: 100%;
    }

    .msg textarea {
        width: 976px;
        max-width: 100%;
        display: block;
        height: 340px;
        padding: 14px 18px;
        border: 1px solid var(--portfolio-input-border);
        border-radius: 14px;
        font-size: 16px;
        color: var(--portfolio-text);
        background: var(--portfolio-surface);
        box-sizing: border-box;
        resize: none;
        font-family: inherit;
    }

    .msg textarea:focus {
        outline: none;
        border-color: var(--portfolio-accent-start);
    }

    .inputs input[type='email']:not(:placeholder-shown):invalid {
        border-color: var(--portfolio-error);
    }

    .inputs input[type='email']:not(:placeholder-shown):valid {
        border-color: var(--portfolio-success);
    }

    button {
        width: 976px;
        max-width: 100%;
        margin-top: 20px;
        padding: 16px 22px;
        border: 1px solid transparent;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--portfolio-accent-start), var(--portfolio-accent-end));
        color: var(--portfolio-button-text);
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: transform .3s, opacity .3s;
    }

    button:hover {
        transform: translateY(-2px);
        opacity: 0.96;
    }

    h1 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 1;
        color: var(--portfolio-heading);
    }

    h3 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(1.25rem, 2.5vw, 1.875rem);
        color: var(--portfolio-accent);
        margin-bottom: -20px;
    }

    @media (max-width: 1360px) {
        .contact-page {
            padding-left: 72px;
            padding-right: 72px;
            margin-left: 40px;
            margin-right: 40px;
        }
    }

    @media (max-width: 1200px) {
        .contact-page {
            padding-left: 48px;
            padding-right: 48px;
            margin-left: 24px;
            margin-right: 24px;
        }

        .inputs {
            gap: 12px;
        }
    }

    @media (max-width: 900px) {
        .inputs {
            flex-direction: column;
        }
    }

    @media (max-width: 768px) {
        .contact-page {
            padding-left: 20px;
            padding-right: 20px;
            margin-left: 0;
            margin-right: 0;
        }
    }
</style>
