---
import flutterImage from '../assets/tecnologys/Flutter.png';
import dartImage from '../assets/tecnologys/Dart.png';
import djangoImage from '../assets/tecnologys/Django.png';
import mapboxImage from '../assets/tecnologys/MapBox.png';
import postgresImage from '../assets/tecnologys/postgresSQL.png';
import restApiImage from '../assets/tecnologys/RESTApi.svg';
import expoImage from '../assets/tecnologys/Expo.svg'
import javaScripImage from '../assets/tecnologys/JavaScript.png'
import reactNativeImage from '../assets/tecnologys/ReactNative.png'
import ProjectContent from './ProjectContent.astro';
import { getLocale, localizePath } from '../i18n/config';
import { ui } from '../i18n/ui';

import calendarImage from '../assets/EcoUshuaia/forDetails/calendar.png';
import mapImage from '../assets/EcoUshuaia/forDetails/map-end.png';
import homeImageEcoUshuaia from '../assets/EcoUshuaia/forDetails/home.png';
import homeImage from '../assets/Foods/Home - foods.png';
import favImage from '../assets/Foods/favorites - foods.png';
import searchImage from '../assets/Foods/searchFoods.png'

const locale = getLocale(Astro.currentLocale);
const t = ui[locale].projects;

// Data EcoUshuaia app

const ecoUshuaiaTecnologyItems = [
    { src: flutterImage.src, alt: 'Flutter icon', label: 'Flutter' },
    { src: dartImage.src, alt: 'Dart icon', label: 'Dart', imageClass: 'icon-dart' },
    { src: restApiImage.src, alt: 'REST API icon', label: 'REST API', imageClass: 'icon-restapi', nowrap: true },
    { src: djangoImage.src, alt: 'Django icon', label: 'Django', imageClass: 'icon-django' },
    { src: postgresImage.src, alt: 'PostgreSQL icon', label: 'PostgreSQL', imageClass: 'icon-postgres' },
    { src: mapboxImage.src, alt: 'Mapbox icon', label: 'Mapbox', imageClass: 'icon-mapbox' },
];

const ecoUshuaiaProjectDescription = [
    ...t.eco.description
];

const ecoUshuaiaProjectLinks = [
    {
        label: t.eco.links.github,
        href: 'https://github.com/CristiannMaidana/EcoUshuaia',
        variant: 'primary' as const,
        target: '_blank',
        rel: 'noreferrer'
    },
    { label: t.eco.links.details, href: localizePath(locale, '/DetailEcoUshuaiaPage'), variant: 'secundary' as const }
];

const ecoUshuaiaProjectImages = [
    { src: calendarImage.src, alt: t.eco.images.calendar, width: calendarImage.width, height: calendarImage.height, imageClass: 'middle' },
    { src: mapImage.src, alt: t.eco.images.map, width: mapImage.width, height: mapImage.height },
    { src: homeImageEcoUshuaia.src, alt: t.eco.images.settings, width: homeImageEcoUshuaia.width, height: homeImageEcoUshuaia.height, imageClass: 'middle' }
];


// Data of Expo app

const appAlimentosTecnologyItems = [
    { src: expoImage.src, alt: 'Expo icon', label: 'Expo', imageClass: 'icon-expo', nowrap: true}, 
    { src: reactNativeImage.src, alt: 'React Native icon', label: 'React Native', imageClass: 'icon-reactnative', nowrap: true },
    { src: javaScripImage.src, alt: 'JavaScript icon', label: 'JavaScript', imageClass: 'icon-javascript', nowrap: true}, 
    { src: restApiImage.src, alt: 'REST API icon', label: 'REST API', imageClass: 'icon-restapi', nowrap: true },
];

const appAlimentosProjectDescription = [
    ...t.food.description
];

const appAlimentosProjectLinks = [
    {
        label: t.food.links.github,
        href: 'https://github.com/CristiannMaidana/AppAlimentos',
        variant: 'primary' as const,
        target: '_blank',
        rel: 'noreferrer'
    },
    { label: t.food.links.details, href: localizePath(locale, '/DetailFoodPage'), variant: 'secundary' as const }
];

const appAlimentosProjectImages = [
    { src: homeImage.src, alt: t.food.images.home, width: homeImage.width, height: homeImage.height, imageClass: 'middle' },
    { src: favImage.src, alt: t.food.images.favorites, width: favImage.width, height: favImage.height },
    { src: searchImage.src, alt: t.food.images.home, width: searchImage.width, height: searchImage.height, imageClass: 'middle' },
];
---

<div id="container-projects">
    <section>
        <h3>{t.eyebrow}</h3>
        <h1>{t.title}</h1>
        <div class="card">
            <ProjectContent
                description={ecoUshuaiaProjectDescription}
                technologies={ecoUshuaiaTecnologyItems}
                links={ecoUshuaiaProjectLinks}
                images={ecoUshuaiaProjectImages}
                imageContainerColor="var(--portfolio-showcase-bg)"
            >
                <p class="project-kicker">{t.eco.kicker}</p>
                <h2>{t.eco.name}</h2>
            </ProjectContent>
        </div>
        
        <div class="card">
            <ProjectContent
                description={appAlimentosProjectDescription}
                technologies={appAlimentosTecnologyItems}
                links={appAlimentosProjectLinks}
                images={appAlimentosProjectImages}
                imageContainerColor="linear-gradient(165deg, #ffd0d0 0%, #ff8a8a 42%, #e04444 100%)"
                showcaseShadowTop="rgba(184, 52, 52, 0.22)"
                showcaseShadowBottom="rgba(196, 47, 47, 0.3)"
            >
                <p class="project-kicker">{t.food.kicker}</p>
                <h2>{t.food.name}</h2>
            </ProjectContent>
        </div>
    </section>
</div>

<style>
    #container-projects,
    section {
        width: 100%;
    }

    .card {
        margin-top: 50px;
        border-radius: 22px;
        border: 1px solid var(--portfolio-border);
        padding: 20px;
    }

    .project-kicker {
        color: var(--portfolio-accent);
        margin-bottom: -20px;
    }

    p {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(1rem, 1.4vw, 1.25rem);
        color: var(--portfolio-muted);
    }

    h1 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 1;
        color: var(--portfolio-heading);
    }

    h2 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(2rem, 4vw, 3.125rem);
        color: var(--portfolio-heading);
        margin-bottom: 20px;
    }

    h3 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(1.25rem, 2.5vw, 1.875rem);
        color: var(--portfolio-accent);
        margin-bottom: -30px;
    }

    @media (max-width: 1360px) {
        .card {
            padding: 16px;
        }
    }

    @media (max-width: 1200px) {
        .card {
            padding: 14px;
        }
    }

    @media (max-width: 768px) {
        .card {
            margin-top: 32px;
            padding: 16px;
        }
    }

</style>
