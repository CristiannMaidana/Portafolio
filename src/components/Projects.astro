---
import flutterImage from '../assets/Flutter.png';
import dartImage from '../assets/Dart.png';
import djangoImage from '../assets/Django.png';
import mapboxImage from '../assets/MapBox.png';
import postgresImage from '../assets/postgresSQL.png';
import restApiImage from '../assets/RESTApi.svg';

import calendarImage from '../assets/EcoUshuaia/Calendar.png'
import mapImage from '../assets/EcoUshuaia/Map.png'
import settingsImage from '../assets/EcoUshuaia/Settings.png'
---

<div id="container-projects">
    <section>
        <h3>Proyectos destacados</h3>
        <h1>Proyectos académicos realizados como productos reales.</h1>
        <div class="card">
            <div class="text">
                <p style="color: #85e7fb; margin-bottom: -20px;">MOBILE APP</p>
                <h2>EcoUshuaia</h2>
                <p>Aplicación móvil enfocada en reciclaje urbano y gestión ambiental desarrollada con Flutter.
                    La app permite visualizar contenedores ecológicos en mapas interactivos, consultar puntos de reciclaje y acceder a novedades y eventos mediantes una interfaz moderna orientada a dispositivos móviles.
                    Desarrollé la arquitectura de la aplicación, la interfaz de usuario, la navegación entre pantallas, la integración con APis REST y los sistemas de mapas y geolocalización.
                </p>
                <div style="flex-direction: row; display: flex; justify-content: flex-start; gap: 18px; width:70%">
                    <div class="tech-item">
                        <div class="tecnology">
                            <img src={flutterImage.src} alt="Flutter icon" />
                        </div>
                        <p>Flutter</p>
                    </div>
                    <div class="tech-item">
                        <div class="tecnology">
                            <img class="icon-dart" src={dartImage.src} alt="Dart icon" />
                        </div>
                        <p>Dart</p>
                    </div>
                    <div class="tech-item">
                        <div class="tecnology">
                            <img class="icon-django" src={djangoImage.src} alt="Django icon" />
                        </div>
                        <p>Django</p>
                    </div>
                    <div class="tech-item">
                        <div class="tecnology">
                            <img class="icon-mapbox" src={mapboxImage.src} alt="Mapbox icon" />
                        </div>
                        <p>Mapbox</p>
                    </div>
                    <div class="tech-item">
                        <div class="tecnology">
                            <img class="icon-postgres" src={postgresImage.src} alt="PostgreSQL icon" />
                        </div>
                        <p>PostgreSQL</p>
                    </div>
                    <div class="tech-item">
                        <div class="tecnology">
                            <img class="icon-restapi" src={restApiImage.src} alt="REST API icon" />
                        </div>
                        <p style="white-space: nowrap;">REST API</p>
                    </div>
                </div>
                <div class="buttons">
                    <button class="bt primary">GitHub</button>
                    <button class="bt secundary">Detalles</button>
                </div>
            </div>
            <div class="image">
                <div class="app-showcase">
                    <img class="app-image middle" src={calendarImage.src} alt="Calendar">
                    <img class="app-image" src={mapImage.src} alt="Map">
                    <img class="app-image middle" src={settingsImage.src} alt="Settings">
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .card {
        flex-direction: row;
        display: flex;
        margin-top: 50px;
        border-radius: 22px;
        border: 1px solid black;
        padding: 20px;
    }

    .text {
        width: 100%;
    }

    .image {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 70%;
        overflow: visible;
    }

    .app-showcase {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 450px;
        overflow: visible;
        border: 1px solid #7fdc8f;
        border-radius: 22px;
        background: linear-gradient(165deg, #d8ffb8 0%, #9af08d 42%, #67d978 100%);
        box-shadow:
            inset 0 2px 0 rgba(255, 255, 255, 0.55),
            inset 0 -18px 28px rgba(53, 144, 68, 0.22),
            0 18px 35px rgba(63, 152, 77, 0.28);
    }
    
    .tecnology img {
        width: 66.67px;
        height: 50px;
    }

    .tecnology img.icon-dart {
        width: 50px;
        height: 50px;

    }

    .tecnology img.icon-mapbox {
        width: 53.34px;
        height: 50px;
    }

    .tecnology img.icon-restapi {
        width: 50px;
        height: 50px;
    }

    .tecnology img.icon-postgres {
        width: 48.53px;
        height: 50px;
    }

    .tecnology img.icon-django {
        width: 39.26px;
        height: 50px;
    }

    .tecnology {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 62px;
        height: 62px;
        border: 1px solid black;
        border-radius: 10px;
        background-color: red;
    }

    .tech-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 78px;
        text-align: center;
    }

    .tecnology + p {
        margin: 6px 0 0;
    }

    .buttons {
        margin-top:30px;
    }

    .bt {
        width: 110px;
        height: 40px;
        border-radius: 20px;
        border: 1px solid transparent;
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
    }

    .bt.primary {
        background: linear-gradient(135deg, #66e3ff, #7c5cff);
        color: #0b0d10;
    }

    .bt.secundary {
        border-color: #d0d7de;
        color: #14191c;
        background: #ffffff;
        margin-left: 10px;
    }

    .app-image {
        height: 400px;
    }

    .app-image.middle { 
        transform: translateY(148px);
    }

    #container-projects {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        margin: 0px 200px;
    }

    p {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 20px;
        color: #333;
    }

    h1 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 80px;
        color: black;
        width: 90%;
    }

    h2 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 50px;
        color: black;
    }

    h3 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 30px;
        color: #85e7fb;
        margin-bottom: -30px;
    }

</style>
