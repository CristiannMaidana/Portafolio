---
import flutterImage from '../assets/Flutter.png';
import dartImage from '../assets/Dart.png';
import djangoImage from '../assets/Django.png';
import mapboxImage from '../assets/MapBox.png';
import postgresImage from '../assets/postgresSQL.png';
import restApiImage from '../assets/RESTApi.svg';
import ProjectContent from './ProjectContent.astro';
import expoImage from '../assets/Expo.svg'
import javaScripImage from '../assets/JavaScript.png'

import calendarImage from '../assets/EcoUshuaia/Calendar.png';
import mapImage from '../assets/EcoUshuaia/Map.png';
import settingsImage from '../assets/EcoUshuaia/Settings.png';

// Data EcoUshuaia app

const ecoUshuaiaTecnologyItems = [
    { src: flutterImage.src, alt: 'Flutter icon', label: 'Flutter' },
    { src: dartImage.src, alt: 'Dart icon', label: 'Dart', imageClass: 'icon-dart' },
    { src: djangoImage.src, alt: 'Django icon', label: 'Django', imageClass: 'icon-django' },
    { src: mapboxImage.src, alt: 'Mapbox icon', label: 'Mapbox', imageClass: 'icon-mapbox' },
    { src: postgresImage.src, alt: 'PostgreSQL icon', label: 'PostgreSQL', imageClass: 'icon-postgres' },
    { src: restApiImage.src, alt: 'REST API icon', label: 'REST API', imageClass: 'icon-restapi', nowrap: true }
];

const ecoUshuaiaProjectDescription = [
    'Aplicación móvil enfocada en reciclaje urbano y gestión ambiental desarrollada con Flutter.',
    'La app permite visualizar contenedores ecológicos en mapas interactivos, consultar puntos de reciclaje y acceder a novedades y eventos mediantes una interfaz moderna orientada a dispositivos móviles.',
    'Desarrollé la arquitectura de la aplicación, la interfaz de usuario, la navegación entre pantallas, la integración con APis REST y los sistemas de mapas y geolocalización.'
];

const ecoUshuaiaProjectLinks = [
    {
        label: 'GitHub',
        href: 'https://github.com/CristiannMaidana/EcoUshuaia',
        variant: 'primary' as const,
        target: '_blank',
        rel: 'noreferrer'
    },
    { label: 'Detalles', href: '/DetailEcoUshuaia', variant: 'secundary' as const }
];

const ecoUshuaiaProjectImages = [
    { src: calendarImage.src, alt: 'Calendar', imageClass: 'middle' },
    { src: mapImage.src, alt: 'Map' },
    { src: settingsImage.src, alt: 'Settings', imageClass: 'middle' }
];


// Data of Expo app

const appAlimentosTecnologyItems = [
    { src: expoImage.src, alt: 'Expo icon', label: 'Expo', imageClass: 'icon-expo', nowrap: true}, 
    { src: javaScripImage.src, alt: 'JavaScript icon', label: 'JavaScript', imageClass: 'icon-javascript', nowrap: true}, 
    { src: restApiImage.src, alt: 'REST API icon', label: 'REST API', imageClass: 'icon-restapi', nowrap: true },
];

const appAlimentosProjectDescription = [
    'Aplicación móvil enfocada en obtener informacion de productos alimenticios.',
    'La app permite visualizar diversas categorias de productos alimenticios, consultar diferentes categorias y productos, ver las caracteristica y nivel de los alimentos, y poder agregar nuevos alimentos mediante una camara nativa. Orientada a dispositivos móviles.',
    'Desarrollé la navegación entre pantallas, la integración con la API de alimentos y la camara integrada para analizar nuevos productos.'
];

const appAlimentosProjectLinks = [
    {
        label: 'GitHub',
        href: 'https://github.com/CristiannMaidana/AppAlimentos',
        variant: 'primary' as const,
        target: '_blank',
        rel: 'noreferrer'
    },
    { label: 'Detalles', variant: 'secundary' as const }
];
---

<div id="container-projects">
    <section>
        <h3>Proyectos destacados</h3>
        <h1>Proyectos académicos realizados como productos reales.</h1>
        <div class="card">
            <ProjectContent
                description={ecoUshuaiaProjectDescription}
                technologies={ecoUshuaiaTecnologyItems}
                links={ecoUshuaiaProjectLinks}
                images={ecoUshuaiaProjectImages}
                imageContainerColor="var(--portfolio-showcase-bg)"
            >
                <p class="project-kicker">MOBILE APP</p>
                <h2>EcoUshuaia</h2>
            </ProjectContent>
        </div>
        
        <div class="card">
            <ProjectContent
                description={appAlimentosProjectDescription}
                technologies={appAlimentosTecnologyItems}
                links={appAlimentosProjectLinks}
                images={ecoUshuaiaProjectImages}
                imageContainerColor="var(--portfolio-showcase-bg)"
            >
                <p class="project-kicker">MOBILE APP</p>
                <h2>Alimentos</h2>
            </ProjectContent>
        </div>
    </section>
</div>

<style>
    #container-projects,
    section {
        width: 100%;
    }

    .card {
        margin-top: 50px;
        border-radius: 22px;
        border: 1px solid var(--portfolio-border);
        padding: 20px;
    }

    .project-kicker {
        color: var(--portfolio-accent);
        margin-bottom: -20px;
    }

    p {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(1rem, 1.4vw, 1.25rem);
        color: var(--portfolio-muted);
    }

    h1 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 1;
        color: var(--portfolio-heading);
    }

    h2 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(2rem, 4vw, 3.125rem);
        color: var(--portfolio-heading);
        margin-bottom: 20px;
    }

    h3 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(1.25rem, 2.5vw, 1.875rem);
        color: var(--portfolio-accent);
        margin-bottom: -30px;
    }

    @media (max-width: 1360px) {
        .card {
            padding: 16px;
        }
    }

    @media (max-width: 1200px) {
        .card {
            padding: 14px;
        }
    }

    @media (max-width: 768px) {
        .card {
            margin-top: 32px;
            padding: 16px;
        }
    }

</style>
