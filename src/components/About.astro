---
import flutterImage from '../assets/tecnologys/Flutter.png';
import dartImage from '../assets/tecnologys/Dart.png';
import djangoImage from '../assets/tecnologys/Django.png';
import postgresImage from '../assets/tecnologys/postgresSQL.png';
import restApiImage from '../assets/tecnologys/RESTApi.svg';
import javaImage from '../assets/tecnologys/Java.png'
import Tecnologys from './tecnologys.astro';
import { getLocale } from '../i18n/config';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.currentLocale);
const t = ui[locale].about;

const tecnologyItems = [
    { src: flutterImage.src, alt: 'Flutter icon', label: 'Flutter' },
    { src: dartImage.src, alt: 'Dart icon', label: 'Dart', imageClass: 'icon-dart' },
    { src: djangoImage.src, alt: 'Django icon', label: 'Django', imageClass: 'icon-django' },
    { src: postgresImage.src, alt: 'PostgreSQL icon', label: 'PostgreSQL', imageClass: 'icon-postgres' },
    { src: restApiImage.src, alt: 'REST API icon', label: 'REST API', imageClass: 'icon-restapi', nowrap: true },
    { src: javaImage.src, alt: 'Java icon', label: 'Java', imageClass: 'icon-java', nowrap: true }
];
---

<div id="container-about">
    <h3>{t.eyebrow}</h3>
    <h1>{t.title}</h1>
    <div class="content">
        <div class="data">
            <h2>{t.profileName}</h2>
            {t.profileParagraphs.map((paragraph) => (
                <p>{paragraph}</p>
            ))}
        </div>
        <div class="tecnology">
            <h2>{t.technologyTitle}</h2>
            <p>{t.technologyParagraph}</p>
            <Tecnologys items={tecnologyItems} />
        </div>
    </div>
</div>

<style>
    #container-about {
        width: 100%;
    }

    .content {
        display: flex;
        flex-direction: row;
        gap: 40px;
        margin-top: 50px;
    }

    .data {
        display: flex;
        flex-direction: column;
        justify-content: center;
        width: 100%;
        border: 1px solid var(--portfolio-border);
        border-radius: 22px;
        padding: 30px;
    }

    .tecnology {
        display: flex;
        flex-direction: column;
        justify-content: center;
        width: 100%;
        border: 1px solid var(--portfolio-border);
        border-radius: 22px;
        padding: 30px;
    }

    .data p:last-child {
        margin-bottom: 78px;
    }

    p {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(1rem, 1.4vw, 1.25rem);
        color: var(--portfolio-muted);
    }

    h1 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 1;
        color: var(--portfolio-heading);
    }

    h2 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: 40px;
        line-height: 1;
        color: var(--portfolio-heading);
    }

    h3 {
        font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
        font-size: clamp(1.25rem, 2.5vw, 1.875rem);
        color: var(--portfolio-accent);
        margin-bottom: -30px;
    }

    @media (max-width: 1360px) {
        .content {
            gap: 28px;
        }

        .data,
        .tecnology {
            padding: 24px;
        }
    }

    @media (max-width: 1200px) {
        .content {
            gap: 24px;
        }

        .data,
        .tecnology {
            padding: 20px;
        }
    }

    @media (max-width: 1024px) {
        .content {
            flex-direction: column;
        }
    }

    @media (max-width: 768px) {
        .content {
            gap: 24px;
            margin-top: 32px;
        }

        .data,
        .tecnology {
            padding: 20px 16px;
        }

        .data p:last-child {
            margin-bottom: 0;
        }
    }
</style>
